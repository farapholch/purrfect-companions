    echo "testfor @e[type=mjau:misty,x=18,y=20,z=18,r=30,has_property={mjau:$1=$2}]"; sleep 1
    echo "kill @e[type=mjau:misty,x=18,y=20,z=18,r=30]"; sleep 1
