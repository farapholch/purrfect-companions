{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.katt.move": {
      "initial_state": "standing",
      "states": {
        "standing": {
          "blend_transition": 0.2,
          "animations": [
            "look",
            "tail"
          ],
          "transitions": [
            {
              "furniture_settle": "q.property('mjau:mobel') == 5 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_spa": "q.property('mjau:mobel') == 6 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_tv": "q.property('mjau:mobel') == 7 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_scratch": "q.property('mjau:mobel') == 8 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_window": "q.property('mjau:mobel') == 11 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_window_settle": "q.property('mjau:mobel') == 12 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_fountain": "q.property('mjau:mobel') == 14 && q.modified_move_speed <= 0.02"
            },
            {
              "sleeping": "(q.is_sleeping || q.property('mjau:sover') == 1) && !q.is_saddled"
            },
            {
              "sitting": "query.is_sitting && query.modified_move_speed <= 0.05 && !q.is_saddled"
            },
            {
              "walking": "query.modified_move_speed > 0.12"
            }
          ]
        },
        "walking": {
          "blend_transition": 0.2,
          "animations": [
            "look",
            "tail",
            "walk"
          ],
          "transitions": [
            {
              "furniture_settle": "q.property('mjau:mobel') == 5 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_spa": "q.property('mjau:mobel') == 6 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_tv": "q.property('mjau:mobel') == 7 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_scratch": "q.property('mjau:mobel') == 8 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_window": "q.property('mjau:mobel') == 11 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_window_settle": "q.property('mjau:mobel') == 12 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_fountain": "q.property('mjau:mobel') == 14 && q.modified_move_speed <= 0.02"
            },
            {
              "sleeping": "(q.is_sleeping || q.property('mjau:sover') == 1) && !q.is_saddled"
            },
            {
              "sitting": "query.is_sitting && query.modified_move_speed <= 0.02 && !q.is_saddled"
            },
            {
              "standing": "query.modified_move_speed <= 0.02"
            }
          ]
        },
        "sitting": {
          "blend_transition": 0.3,
          "animations": [
            "sit",
            "look"
          ],
          "transitions": [
            {
              "furniture_settle": "q.property('mjau:mobel') == 5 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_spa": "q.property('mjau:mobel') == 6 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_tv": "q.property('mjau:mobel') == 7 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_scratch": "q.property('mjau:mobel') == 8 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_window": "q.property('mjau:mobel') == 11 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_window_settle": "q.property('mjau:mobel') == 12 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_fountain": "q.property('mjau:mobel') == 14 && q.modified_move_speed <= 0.02"
            },
            {
              "sleeping": "(q.is_sleeping || q.property('mjau:sover') == 1) && !q.is_saddled"
            },
            {
              "walking": "query.modified_move_speed > 0.12"
            },
            {
              "standing": "q.is_saddled || !query.is_sitting"
            }
          ]
        },
        "sleeping": {
          "blend_transition": 0.3,
          "animations": [
            "sova"
          ],
          "transitions": [
            {
              "furniture_settle": "q.property('mjau:mobel') == 5 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_spa": "q.property('mjau:mobel') == 6 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_tv": "q.property('mjau:mobel') == 7 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_scratch": "q.property('mjau:mobel') == 8 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_window": "q.property('mjau:mobel') == 11 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_window_settle": "q.property('mjau:mobel') == 12 && q.modified_move_speed <= 0.02"
            },
            {
              "furniture_fountain": "q.property('mjau:mobel') == 14 && q.modified_move_speed <= 0.02"
            },
            {
              "walking": "q.modified_move_speed > 0.12"
            },
            {
              "standing": "q.is_saddled || (!q.is_sleeping && q.property('mjau:sover') != 1)"
            }
          ]
        },
        "furniture_settle": {
          "blend_transition": 0.3,
          "animations": [
            "korglagg"
          ],
          "transitions": [
            {
              "walking": "q.modified_move_speed > 0.12"
            },
            {
              "standing": "q.property('mjau:mobel') != 5"
            },
            {
              "furniture_sleep": "q.any_animation_finished"
            }
          ]
        },
        "furniture_sleep": {
          "blend_transition": 0.3,
          "animations": [
            "korgvila"
          ],
          "transitions": [
            {
              "walking": "q.modified_move_speed > 0.12"
            },
            {
              "standing": "q.property('mjau:mobel') != 5"
            }
          ]
        },
        "furniture_spa": {
          "blend_transition": 0.3,
          "animations": [
            "spa"
          ],
          "transitions": [
            {
              "walking": "q.modified_move_speed > 0.12"
            },
            {
              "standing": "q.property('mjau:mobel') != 6"
            }
          ]
        },
        "furniture_tv": {
          "blend_transition": 0.3,
          "animations": [
            "tv"
          ],
          "transitions": [
            {
              "walking": "q.modified_move_speed > 0.12"
            },
            {
              "standing": "q.property('mjau:mobel') != 7"
            }
          ]
        },
        "furniture_scratch": {
          "blend_transition": 0.3,
          "animations": [
            "scratch"
          ],
          "transitions": [
            {
              "walking": "q.modified_move_speed > 0.12"
            },
            {
              "standing": "q.property('mjau:mobel') != 8"
            }
          ]
        },
        "furniture_window": {
          "blend_transition": 0.3,
          "animations": [
            "window"
          ],
          "transitions": [
            {
              "walking": "q.modified_move_speed > 0.12"
            },
            {
              "standing": "q.property('mjau:mobel') != 11"
            }
          ]
        },
        "furniture_window_settle": {
          "blend_transition": 0.3,
          "animations": [
            "windowlagg"
          ],
          "transitions": [
            {
              "walking": "q.modified_move_speed > 0.12"
            },
            {
              "standing": "q.property('mjau:mobel') != 12"
            },
            {
              "furniture_window_sleep": "q.any_animation_finished"
            }
          ]
        },
        "furniture_window_sleep": {
          "blend_transition": 0.3,
          "animations": [
            "korgvila"
          ],
          "transitions": [
            {
              "walking": "q.modified_move_speed > 0.12"
            },
            {
              "standing": "q.property('mjau:mobel') != 12"
            }
          ]
        },
        "furniture_fountain": {
          "blend_transition": 0.3,
          "animations": [
            "fountain"
          ],
          "transitions": [
            {
              "walking": "q.modified_move_speed > 0.12"
            },
            {
              "standing": "q.property('mjau:mobel') != 14"
            }
          ]
        }
      }
    }
  }
}
