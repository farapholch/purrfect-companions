        # Avstigningsprompten byggs som action.hint.exit.<entity-id> och har
        # ingen vanilla-motsvarighet för egna varelser.
        if "minecraft:rideable" in grp and f"action.hint.exit.{cid}=" not in _lang:
            bad.append(f"{cid}: rideable men action.hint.exit.{cid} saknas i en_US.lang")
    tam=comp.get("minecraft:tameable",{})
    for ti in tam.get("tame_items",[]):
        if ":" not in ti and ti in shortnames:
            bad.append(f"{cid}: tame_items '{ti}' saknar namnrymd")
# Utan texts/languages.json läser Bedrock inte .lang-filen alls: alla namn faller
# tillbaka på råa identifierare (våra är svenska) och hint-nycklar visas i klartext.
# Felet är helt tyst — servern bryr sig inte om texter.
for _pack in ("PurrfectCompanions_BP","PurrfectCompanions_RP"):
    _tx=f"{SRC}/{_pack}/texts"
    _langs=[os.path.basename(x)[:-5] for x in glob.glob(f"{_tx}/*.lang")]
    _lj=f"{_tx}/languages.json"
    if _langs and not os.path.exists(_lj):
        bad.append(f"{_pack}: har {len(_langs)} .lang-filer men saknar texts/languages.json "
                   f"— inga översättningar laddas")
    elif _langs:
        _dec=json.load(open(_lj,encoding="utf-8"))
        for _l in _langs:
            if _l not in _dec:
                bad.append(f"{_pack}: {_l}.lang finns men är inte deklarerad i languages.json")

# STORLEKEN SKA MÄRKAS. Katterna hade alla 20 liv och träffytan 0,7 trots skala
# 0,85-1,15, och minecraft:scale skalar MODELLEN men inte kollisionslådan — en
# birma var lika bred att gå in i som en ragdoll. Båda härleds numera ur skalan,
# och kontrollen räknar om det: ett handredigerat värde eller en generator som
# slutar sätta dem faller här.
for _f in glob.glob(f"{SRC}/PurrfectCompanions_BP/entities/*.json"):
    _e = json.load(open(_f, encoding="utf-8"))["minecraft:entity"]
    _g = _e.get("component_groups", {})
    if "mjau:saddled" not in _g:
        continue                      # vakthunden och fordonen är inga katter
    _sk = _g.get("mjau:adult", {}).get("minecraft:scale", {}).get("value")
    if _sk is None:
        bad.append(f"{os.path.basename(_f)}: saknar skala i mjau:adult"); continue
    _vantad_liv = max(2, round(20 * _sk / 2) * 2)
    _liv = _e["components"].get("minecraft:health", {}).get("value")
    if _liv != _vantad_liv:
        bad.append(f"{os.path.basename(_f)}: liv {_liv}, väntade {_vantad_liv} "
                   f"för skala {_sk} — kör build_accessories.py")
    _br = _e["components"].get("minecraft:collision_box", {}).get("width")
    if _br != round(0.7 * _sk, 2):
        bad.append(f"{os.path.basename(_f)}: träffyta {_br}, väntade "
                   f"{round(0.7 * _sk, 2)} för skala {_sk} — scale skalar inte lådan")
    # och rustningen ska ADDERA, inte platta ut skillnaden
    for _niva, _plus in ((1, 20), (2, 24), (3, 30), (4, 40)):
        _rh = _g.get(f"mjau:armored_{_niva}", {}).get("minecraft:health", {}).get("value")
        if _rh is not None and _rh != _liv + _plus:
            bad.append(f"{os.path.basename(_f)}: rustning {_niva} ger {_rh} liv, "
                       f"väntade {_liv}+{_plus} — den plattar ut storleken igen")

# --- generatorer som ACKUMULERAR ------------------------------------------
# build_accessories.py PATCHAR entiteterna, den skriver dem inte från grunden.
# Rader som bara la TILL i en händelsesekvens la därför på ett par till vid
# varje körning, och det syns inte: JSON:en blir bara längre. Vid upptäckten låg
# det 32 rosettslumpningar i varje katt, och effekten var total — "ibland född
# med rosett" är 40 % en gång, men 1 - 0,6^32 = 100 % trettiotvå gånger. VARJE
# kattunge föddes med rosett. Det hade legat ute i alla släpp sedan funktionen
# kom.
#
# Regeln: ingen händelsesekvens får ha två slumpningar som sätter SAMMA
# egenskap. Två sådana är antingen ackumulation eller en logisk krock, och
# ingendera är avsiktlig.
for _f in glob.glob(f"{SRC}/PurrfectCompanions_BP/entities/*.json"):
    _e = json.load(open(_f, encoding="utf-8"))["minecraft:entity"]
    for _ev, _kropp in _e.get("events", {}).items():
        _rakn = {}
        for _steg in (_kropp.get("sequence") or []):
            for _gren in (_steg.get("randomize") or []):
                for _prop in (_gren.get("set_property") or {}):
                    _rakn[_prop] = _rakn.get(_prop, 0) + 1
        # varje slumpning har flera grenar som sätter samma egenskap — det är
        # antalet SLUMPNINGAR som ska vara ett, inte antalet grenar
        _block = {}
        for _steg in (_kropp.get("sequence") or []):
            _satta = {p for g in (_steg.get("randomize") or []) for p in (g.get("set_property") or {})}
            for _p in _satta:
                _block[_p] = _block.get(_p, 0) + 1
        for _p, _n in sorted(_block.items()):
            if _n > 1:
                bad.append(f"{os.path.basename(_f)}: {_ev} har {_n} slumpningar som "
                           f"sätter {_p} — generatorn ackumulerar")
        # SAMMA ACKUMULERING, ANNAN LISTA. Spärren ovan bevakade bara
        # randomize-blocken, för det var där felet hittades förra gången. Under
        # tiden växte mjau:on_tame sin component_groups-lista till NIO kopior av
        # mjau:gavor, en per bygge, utan att någon sa något — motorn struntar i
        # dubbletter, så det syns bara i diffen. En spärr som bara känner igen
        # det fel den redan sett är halva spärren; den här tar alla listor.
        for _plats in ("add", "remove"):
            for _kalla in ([_kropp] + (_kropp.get("sequence") or [])
                           + [_g for _st in ([_kropp] + (_kropp.get("sequence") or []))
                              for _g in (_st.get("randomize") or [])]):
                _cg = (_kalla.get(_plats) or {}).get("component_groups")
                if isinstance(_cg, list) and len(_cg) != len(set(_cg)):
                    _dubb = sorted({c for c in _cg if _cg.count(c) > 1})
                    bad.append(f"{os.path.basename(_f)}: {_ev}/{_plats} har "
                               f"dubbletter av {', '.join(_dubb)} — generatorn ackumulerar")

# --- Kattbokens språknycklar ----------------------------------------------
# BOKEN ÄR EN GUIDE, och en guide som visar "mjau.bok.plagg.krona" i klartext är
# värre än ingen guide. Innehållet genereras ur ACC, men PROSAN är handskriven
# per plagg — lägger någon till ett plagg utan att skriva dess rad syns det bara
# i spelet, i en meny som testet aldrig öppnar. Här i stället.
_bokjs = open(f"{SRC}/PurrfectCompanions_BP/scripts/main.js", encoding="utf-8").read()
_bokkrav = set(re.findall(r'"(mjau\.bok\.[a-z0-9_.]+)"', _bokjs))
# de numrerade familjerna kommer ur stycken("mjau.bok.kan.", 7) och liknande
for _pre, _n in re.findall(r'stycken\("(mjau\.bok\.[a-z.]+)",\s*(\d+)\)', _bokjs):
    _bokkrav.discard(_pre)
    _bokkrav |= {f"{_pre}{i}" for i in range(1, int(_n) + 1)}
# ...och en rad per plagg, hämtad ur den GENERERADE bokdatan, inte ur en lista här
_bd = open(f"{SRC}/PurrfectCompanions_BP/scripts/bokdata.js", encoding="utf-8").read()
_plagg = json.loads(re.search(r"export const PLAGG = (\[.*?\]);", _bd, re.S).group(1))
# ...och en rad bara för de plagg som FÅR en. Kravet följer flaggan i den
# genererade bokdatan, så ett nytt plagg tvingar fram ett beslut: antingen står
# det i _BOKPROSA och behöver en mening, eller så gör det inte det.
_bokkrav |= {f"mjau.bok.plagg.{p['id']}" for p in _plagg if p.get("prosa")}
_bokkrav = {k for k in _bokkrav if not k.endswith(".")}
# Även här: klienten läser bara resurspaketets språkfil.
_RPTX0 = f"{SRC}/PurrfectCompanions_RP/texts"
for _spr in json.load(open(f"{_RPTX0}/languages.json", encoding="utf-8")):
    _har = {r.split("=", 1)[0] for r in open(f"{_RPTX0}/{_spr}.lang", encoding="utf-8").read().split("\n") if "=" in r}
    for _k in sorted(_bokkrav - _har):
        bad.append(f"RP/{_spr}.lang saknar Kattbokens nyckel '{_k}'")
# ALLT BOKEN VISAR MÅSTE GÅ ATT ÖVERSÄTTA. Boken renderar rawtext-nycklar för
# bedrifter, möbler, katter och effekter. Saknas någon av dem visar guiden en
# RÅ NYCKEL mitt i menyn — och menyn öppnas aldrig av något test, så felet syns
# först hos en spelare. Nycklarna härleds ur den GENERERADE bokdatan och ur
# skriptets egna listor, inte ur en kopia här.
_bokvisar = set()
for _fam in ("KATT_ORDER", "KATTGARDEN_ORDER"):
    _m = re.search(rf"const {_fam} = \[(.*?)\];", _bokjs, re.S)
    if _m:
        _bokvisar |= {f"mjau.achv.{i}" for i in re.findall(r'"([a-z_]+)"', _m.group(1))}
_bokvisar |= {f"tile.{b}.name" for b in
              json.loads(re.search(r"export const MOBLER = (\[.*?\]);", _bd, re.S).group(1))}
_bokvisar |= {f"entity.{k['id']}.name" for k in
              json.loads(re.search(r"export const KATTER = (\[.*?\]);", _bd, re.S).group(1))}
# BARA RESURSPAKETET. Bedrock översätter på KLIENTEN, och klienten får bara
# resurspaketets språkfil — beteendepaketets kopia skickas aldrig dit. Första
# versionen av den här grinden krävde nycklarna i båda paketen och underkände
# sexton bedrifter som har fungerat i femton släpp; de har alltid legat enbart i
# RP. En grind som kräver något spelet inte läser skapar arbete, inte kvalitet.
_RPTX = f"{SRC}/PurrfectCompanions_RP/texts"
for _spr in json.load(open(f"{_RPTX}/languages.json", encoding="utf-8")):
    _har = {r.split("=", 1)[0] for r in open(f"{_RPTX}/{_spr}.lang", encoding="utf-8").read().split("\n") if "=" in r}
    for _k in sorted(_bokvisar - _har):
        bad.append(f"RP/{_spr}.lang saknar '{_k}', som Kattboken visar")

# EFFEKTNYCKLARNA ÄR VANILJAS EGNA och kontrolleras mot MOTORNS språkfil, inte
# mot vår. Poängen med att låna dem är att effektnamnen blir översatta på alla
# språk gratis — men en felstavad nyckel ger en rå sträng i stället, och den
# stavningen är lätt att få fel: prefixet är "potion.", inte "effect.", och
# hoppkraften heter potion.jump och inte potion.jumpBoost.
_VLANG = "/opt/bds/server/resource_packs/vanilla/texts/en_US.lang"
if os.path.exists(_VLANG):
    _vanilj = {r.split("=", 1)[0] for r in open(_VLANG, encoding="utf-8").read().split("\n") if "=" in r}
    for _p in json.loads(re.search(r"export const PLAGG = (\[.*?\]);", _bd, re.S).group(1)):
        if _p["effekt"] and _p["effekt"] not in _vanilj:
            bad.append(f"Kattboken: effektnyckeln '{_p['effekt']}' ({_p['id']}) finns inte i vanilla")

# VARJE PLAGG BOKEN LISTAR MÅSTE FINNAS SOM FÖREMÅL. Boken läser en genererad
# tabell; blir tabellen och föremålen osynkade lovar guiden något man inte kan
# tillverka.
for _p in json.loads(re.search(r"export const PLAGG = (\[.*?\]);", _bd, re.S).group(1)):
    if not glob.glob(f"{SRC}/PurrfectCompanions_BP/items/{_p['id']}_*.json"):
        bad.append(f"Kattboken listar '{_p['id']}' men inget sådant föremål finns")

# EN .lang-RAD MÅSTE VARA EN RAD. Bedrock stödjer inga \n-escapes (vaniljas egen
# fil har noll stycken), och en flerradig text sprängde filformatet: värdet
# hamnade som rader utan '=' som spelet tyst hoppar över.
for _pack in ("PurrfectCompanions_BP", "PurrfectCompanions_RP"):
    for _spr in json.load(open(f"{SRC}/{_pack}/texts/languages.json", encoding="utf-8")):
        _fil = f"{SRC}/{_pack}/texts/{_spr}.lang"
        for _n, _r in enumerate(open(_fil, encoding="utf-8").read().split("\n"), 1):
            if _r.strip() and "=" not in _r and not _r.lstrip().startswith("#"):
                bad.append(f"{_pack}/{_spr}.lang rad {_n} saknar '=' — trasig flerradig text?")

# --- klientsidig geometri & animation -------------------------------------
# Servern kör aldrig render controllers eller animationer, så allt nedan är
# sådant live-testet omöjligt kan upptäcka. Tre buggar nådde Pelle den vägen.
_geo=json.load(open(f"{SRC}/PurrfectCompanions_RP/models/entity/katt.geo.json",encoding="utf-8"))
_all={g["description"]["identifier"]:g for g in _geo["minecraft:geometry"]}
_basebones={b["name"]:b for b in _all["geometry.katt"]["bones"]}

# 1. Ett plagg roterar kring sin egen pivot. Skiljer den sig från kroppsdelens
#    svänger plagget ut vid sidan om katten (kronan gjorde det).
for gid,g in _all.items():
    if gid=="geometry.katt": continue
    for b in g.get("bones",[]):
        ref=_basebones.get(b["name"])
        if ref and b.get("pivot")!=ref.get("pivot"):
            bad.append(f"{gid}: ben '{b['name']}' har pivot {b.get('pivot')}, "
                       f"grundmodellen har {ref.get('pivot')}")

# 2. Svansen har regredierat åt båda hållen: först svävande (rörde kroppen bara
#    i en kant), sedan stubbig (begravd en enhet inne i kroppen). Den ska ligga
#    exakt an mot kroppens bakre yta.
_bc=_basebones["body"]["cubes"][0]; _tc=_basebones["tail"]["cubes"][0]
_body_back=_bc["origin"][2]+_bc["size"][2]
if _tc["origin"][2]!=_body_back:
    bad.append(f"svansen börjar vid z={_tc['origin'][2]} men kroppen slutar vid "
               f"z={_body_back} — {'begravd i kroppen' if _tc['origin'][2]<_body_back else 'svävar bakom kroppen'}")
if _tc["origin"][1] >= _bc["origin"][1]+_bc["size"][1]:
    bad.append("svansen sitter helt ovanför kroppen — den nuddar bara översta kanten")

# 3. Ett tillstånd man inte kan lämna medan katten förflyttar sig ger en katt
#    som glider fram utan att röra benen.
_ac=json.load(open(f"{SRC}/PurrfectCompanions_RP/animation_controllers/katt.animation_controllers.json",encoding="utf-8"))
for cname,ctrl in _ac["animation_controllers"].items():
    for sname,st in ctrl["states"].items():
        conds=" ".join(k for t in st.get("transitions",[]) for k in t.values())
        if not st.get("transitions"):
            bad.append(f"{cname}: tillstånd '{sname}' saknar utgång")
        elif "walk" not in sname and not any(q in conds for q in ("ground_speed","move_speed")):
            bad.append(f"{cname}: '{sname}' kan inte lämnas när katten börjar gå")
        # Utan blend_transition snäpper posen till direkt vid varje tillståndsbyte
        # — det är den "fladdriga" animationen mellan stå/gå/sitt/sov.
        if "blend_transition" not in st:
            bad.append(f"{cname}: tillstånd '{sname}' saknar blend_transition — hård övergång fladdrar")
    # HYSTERESIS: in-tröskeln till walking måste vara HÖGRE än ut-tröskeln —
    # samma värde åt båda hållen vippar tillståndet vid stopp (benfladder)
    import re as _re
    _conds=json.dumps(_ac["animation_controllers"])
    _in=[float(m) for m in _re.findall(r"walking[^}]*?move_speed > ([0-9.]+)", _conds)]
    _ut=[float(m) for m in _re.findall(r"standing[^}]*?move_speed <= ([0-9.]+)", _conds)]
    if _in and _ut and min(_in) <= max(_ut):
        bad.append(f"{cname}: gå-tröskeln in ({min(_in)}) måste vara > ut ({max(_ut)}) — annars fladdrar stoppet")

# --- glesa blockmodeller får ALDRIG vara opaque --------------------------
# opaque säger åt spelet att blocket fyller hela kuben -> grannblockens ytor
# cullas. På en gles modell (kattlucka-karm, 5px hög kattbädd...) blir
# resultatet "gropar i golvet"/trasiga väggar runt blocket. 2.6.1 fixade bara
# kattluckan; Xbox-speltestet 2026-08-09 hittade samma sjuka i ALLA möbler
# ("allt ligger nertryckt i golvet"). Kolla varje blocks geometri mot 16³.
_geos={}
for _gf in glob.glob(f"{SRC}/PurrfectCompanions_RP/models/**/*.json", recursive=True):
    for _g in json.load(open(_gf)).get("minecraft:geometry",[]):
        _cubes=[c for b in _g["bones"] for c in b.get("cubes",[])]
        if not _cubes: continue
        _full=any(tuple(c["size"])==(16,16,16) and c["origin"][1]==0 for c in _cubes)
        _geos[_g["description"]["identifier"]]=_full
for _bf in sorted(glob.glob(f"{SRC}/PurrfectCompanions_BP/blocks/*.json")):
    _bc=json.load(open(_bf))["minecraft:block"]["components"]
    _bid=os.path.basename(_bf)[:-5]
    _rm=_bc.get("minecraft:material_instances",{}).get("*",{}).get("render_method")
    _gid=_bc.get("minecraft:geometry")
    if isinstance(_gid,dict): _gid=_gid.get("identifier")
    if _rm=="opaque" and not _geos.get(_gid,False):
        bad.append(f"{_bid}: render_method 'opaque' på gles modell ({_gid}) — "
                   f"grannytor cullas, ser ut som en grop (använd alpha_test)")
# kattluckan är dessutom en dörr: kollisionslåda = ingen kan gå igenom
_kl=f"{SRC}/PurrfectCompanions_BP/blocks/kattlucka.json"
if os.path.exists(_kl):
    _klc=json.load(open(_kl))["minecraft:block"]["components"]
    if _klc.get("minecraft:collision_box") is not False:
        bad.append("kattlucka: har kollisionslåda — då kan man inte gå igenom "
                   "kattdörren (sätt collision_box: false)")

# --- ansiktena måste vara målade -----------------------------------------
# make_cat_markings.py läser den orörda konsten i art/kattpalsar/ och skriver
# HELA texturen — även huvudet, som den inte målar. Kör man den ensam nollas
# alltså ansiktet som make_cat_faces.py målat, utan ett ord någonstans.
# Körordningen står bara i docstrings, och en körordning som bara står i text
# är precis den sortens "två ställen att hålla i synk" som det här paketet har
# gått i förr. Den här spärren är det andra stället, fast körbart.
_G = json.load(open(f"{SRC}/PurrfectCompanions_RP/models/entity/katt.geo.json"))
_hd = next(b for b in _G["minecraft:geometry"][0]["bones"] if b["name"] == "head")
_sk = max(_hd["cubes"], key=lambda c: c["size"][0] * c["size"][1])
_fx, _fy, _fw, _fh = rr.faces(_sk["uv"][0], _sk["uv"][1], *_sk["size"])["north"]
_fx, _fy = int(_fx), int(_fy)
# ALLA KATTER, inte en handskriven lista. Först stod fyra namn här, och då
# missades Aurora, Nova, Spökkatten och Midnight helt — de byggs av egna recept
# och hade kvar det gamla ansiktet plus en omålad nos. En lista som ska hållas i
# synk med paketet är alltid samma fälla.
_KATTER = []
for _ef in sorted(glob.glob(f"{SRC}/PurrfectCompanions_RP/entity/*.json")):
    _ed = json.load(open(_ef))["minecraft:client_entity"]["description"]
    if _ed.get("geometry", {}).get("default") == "geometry.katt":
        _KATTER.append((_ed["identifier"].split(":")[1], _ed["textures"]["default"]))
for _ras, _texvag in _KATTER:
    _tf = f"{SRC}/PurrfectCompanions_RP/{_texvag}.png"
    if not os.path.exists(_tf): continue
    _w, _h, _p = rr.read_png(_tf)
    _at = lambda k, r: tuple(_p[_fy + r][_fx + k])[:3]
    # ÖGAT SKA VARA 2x3. Rad 3 under irisen ska ligga i samma färgfamilj som
    # irisen på rad 2 — gör den inte det är ansiktet det gamla 2x2-ögat.
    for _k in (0, 1, 4, 5):
        if sum(abs(_at(_k, 3)[_i] - _at(_k, 2)[_i]) for _i in range(3)) / 3 > 70:
            bad.append(f"{_ras}: ögat är tillbaka på 2x2 — kör "
                       f"tools/make_cat_faces.py efter make_cat_markings.py")
            break
    # MUNNEN SKA VARA VARM, inte det svarta strecket (26,18,14).
    # MUNNEN SITTER PÅ NOS-KUBEN nu, inte på skallens platta framsida. Rutan
    # bakom nosen ska vara nospartiets ljusa färg — är den mörk ligger det gamla
    # svarta strecket kvar där.
    if sum(_at(2, 4)) < 120:
        bad.append(f"{_ras}: munnen är tillbaka som svart streck {_at(2, 4)} — kör "
                   f"tools/make_cat_faces.py sist i kedjan")

# --- huvudet får inte vara platt -----------------------------------------
# Katthuvudet var länge EN enda kub, så hela ansiktet låg i ett plan och varje
# drag var målat. Omdömet från soffan blev "ansiktena är väldigt platta", och
# det var bokstavligt sant: i profil var katten en tegelsten. Nosen är nu en
# egen kub som sticker fram. Den spärren finns för att ingen ska kunna städa
# bort den i en geometriuppstädning utan att märka vad som försvann.
_bas = next(g for g in _G["minecraft:geometry"]
            if g["description"]["identifier"] == "geometry.katt")
_hd2 = next(b for b in _bas["bones"] if b["name"] == "head")
_sk2 = max(_hd2["cubes"], key=lambda c: c["size"][0] * c["size"][1])
_fram = _sk2["origin"][2]                       # skallens framkant
_nosar = [c for c in _hd2["cubes"] if c["origin"][2] < _fram - 0.1]
if not _nosar:
    bad.append("katt.geo.json: huvudet har ingen kub framför skallen — ansiktet "
               "är platt igen (nosen ska sticka ut)")
else:
    _n2 = min(_nosar, key=lambda c: c["origin"][2])
    if _fram - _n2["origin"][2] < 0.5:
        bad.append(f"katt.geo.json: nosen sticker bara ut "
                   f"{_fram - _n2['origin'][2]:.2f} enheter — det syns inte")
    # NOSEN FÅR INTE TÄCKA ÖGONEN. Ögonen sitter i kolumn 0-1 och 4-5 av sex,
    # alltså utanför x -1..1; en bredare nos skymmer dem inifrån.
    if _n2["origin"][0] < -1.05 or _n2["origin"][0] + _n2["size"][0] > 1.05:
        bad.append(f"katt.geo.json: nosen är {_n2['size'][0]} bred och når "
                   f"utanför x -1..1 — den skymmer ögonen")
    # KINDTOTTARNA. Huvudet var en 6x5x4-låda och lästes som en låda; kinderna
    # gör det bredare nedtill än upptill, så konturen byter bredd och slutar
    # vara en rektangel. Utan dem är omdömet "fyrkantigt" tillbaka.
    _kinder = [c for c in _hd2["cubes"]
               if c["origin"][1] < _sk2["origin"][1] + _sk2["size"][1] - 0.5
               and (c["origin"][0] < _sk2["origin"][0] - 0.05
                    or c["origin"][0] + c["size"][0]
                    > _sk2["origin"][0] + _sk2["size"][0] + 0.05)]
    if len(_kinder) != 2:
        bad.append(f"katt.geo.json: hittade {len(_kinder)} kindtottar, ska vara 2 "
                   f"— utan dem är huvudet en rektangel igen")
    # ...och den måste vara målad. En omålad kub är genomskinlig och syns inte,
    # vilket ser exakt ut som att den inte finns.
    _nf = rr.faces(_n2["uv"][0], _n2["uv"][1], *_n2["size"])["north"]
    for _ras, _texvag in _KATTER:
        _tf = f"{SRC}/PurrfectCompanions_RP/{_texvag}.png"
        if not os.path.exists(_tf): continue
        _w, _h, _p = rr.read_png(_tf)
        _rutor = [tuple(_p[_y][_x]) for _y in range(int(_nf[1]), int(_nf[1] + _nf[3]))
                  for _x in range(int(_nf[0]), int(_nf[0] + _nf[2]))]
        if any(_c[3] == 0 for _c in _rutor):
            bad.append(f"{_ras}: nosens framsida är omålad — kör "
                       f"tools/make_cat_faces.py sist i kedjan")
        elif len({_c[:3] for _c in _rutor}) < 2:
            # EN ENFÄRGAD NOS ÄR EN BLANK LÅDA i ansiktet. Det var precis vad
            # Aurora, Nova, Spökkatten och Midnight fick när ansiktssteget bara
            # kände till fyra raser.
            bad.append(f"{_ras}: nosens framsida är enfärgad {_rutor[0][:3]} — "
                       f"ingen nos och ingen mun, kör tools/make_cat_faces.py")

# --- innerörat: centrerat, synligt, och inte utanför framsidan -------------
# Mätt över alla tio katterna var det ett lapptäcke: fyra hade inget inneröra
# alls, två hade ett som skilde tjugo steg från pälsen och alltså inte syntes,
# två hade rosa och två vitt. På alla satt det dessutom en halv texel snett och
# läckte ut på örats SIDA, eftersom framsidan börjar på x 33,30 och texel 33
# därmed till en tredjedel ligger på västsidan. Ingen spärr hade sagt något,
# för varje enskild fil var giltig.
_oronkuber = [c for c in _hd2["cubes"]
              if c is not _sk2 and c["origin"][2] >= _sk2["origin"][2] - 0.1
              and c["origin"][1] >= _sk2["origin"][1] + _sk2["size"][1] - 0.5]
for _ok in _oronkuber:
    _of = rr.faces(_ok["uv"][0], _ok["uv"][1], *_ok["size"])
    _fx, _fy, _fw, _fh = _of["north"]
    for _ras, _texvag in _KATTER:
        _tf = f"{SRC}/PurrfectCompanions_RP/{_texvag}.png"
        if not os.path.exists(_tf): continue
        _w, _h, _p = rr.read_png(_tf)
        _r = {}
        for _y in range(int(_fy), int(_fy + _fh) + 1):
            for _x in range(int(_fx), int(_fx + _fw) + 1):
                _r.setdefault(tuple(_p[_y][_x][:3]), []).append(_x)
        _pals = max(_r, key=lambda k: len(_r[k]))
        _inner = [k for k in _r if k != _pals]
        if not _inner:
            bad.append(f"{_ras}: örat uv{_ok['uv']} saknar inneröra"); continue
        _ip = _inner[0]
        _kol = sorted(set(_r[_ip]))
        _kontrast = sum(abs(_ip[_i] - _pals[_i]) for _i in range(3)) / 3
        if _kontrast < 22:
            bad.append(f"{_ras}: innerörat {_ip} skiljer bara {_kontrast:.0f} från "
                       f"örat {_pals} — det syns inte")
        if len(_kol) != 1:
            bad.append(f"{_ras}: innerörat ligger på {len(_kol)} kolumner "
                       f"{_kol} — en jämnbred fläck går inte att centrera på "
                       f"en framsida som är {_fw} texlar bred")
        elif abs((_kol[0] + 0.5) - (_fx + _fw / 2)) > 0.01:
            bad.append(f"{_ras}: innerörats mitt {_kol[0] + 0.5} ligger inte på "
                       f"framsidans mitt {_fx + _fw / 2}")
        # ...och det får inte finnas på sidoytorna. Där är det läckage, och det
        # syns som en rosa fläck på utsidan av örat.
        for _sida in ("west", "east", "top"):
            _sx, _sy, _sw, _sh = _of[_sida]
            if any(tuple(_p[_y][_x][:3]) == _ip
                   for _y in range(int(_sy), int(_sy + _sh))
                   for _x in range(int(_sx), int(_sx + _sw))):
                bad.append(f"{_ras}: innerörat läcker ut på örats {_sida}-sida")

# --- inget block får se ut som JORD när det går sönder --------------------
# Bedrock plockar sönderslagningspartiklarna ur blockets egen textur, och ett
# block utan kollisionslåda sprutar dem i HELA kubens volym. Kattluckan var
# enfärgat (142,104,66) — åtta enheter från vanillas jordblock — så att slå
# sönder den gav ett brunt jordmoln mitt i vardagsrummet. Barnen rapporterade
# det som "den har jord-effekt när man tar bort den", vilket var exakt rätt.
_JORDAR = [(134, 96, 67), (150, 108, 74), (119, 85, 59)]   # dirt, coarse, podzol
for _tf in sorted(glob.glob(f"{SRC}/PurrfectCompanions_RP/textures/blocks/*.png")):
    _w, _h, _px = rr.read_png(_tf)
    _c = _Counter(tuple(p[:3]) for _row in _px for p in _row if p[3] > 0)
    if not _c: continue
    _dom, _n = _c.most_common(1)[0]
    if _n / (_w * _h) < 0.35:
        continue                       # brokig textur, partiklarna blir brokiga
    # MEDELAVVIKELSE, inte största kanalskillnad. Kattbädden är plommonlila
    # (108,61,79) och skiljer sig 35 i en enda kanal men bara 18 i snitt — den
    # LÄSER inte som jord, och en spärr som klagar på den lär mig att ignorera
    # den. Jorden är brun i alla tre kanalerna samtidigt; det är snittet som
    # fångar det.
    _nara = min(sum(abs(_dom[i] - _j[i]) for i in range(3)) / 3 for _j in _JORDAR)
    if _nara < 14:
        bad.append(f"{os.path.basename(_tf)}: {_n * 100 // (_w * _h)}% av texturen är "
                   f"{_dom}, som ligger {_nara} från jord — partiklarna när blocket "
                   f"går sönder ser ut som ett jordblock")

