import json, os, sys, glob
d = sys.argv[1]; rp = f"{d}/PurrfectCompanions_RP"; bad = []
it = json.load(open(f"{rp}/textures/item_texture.json"))["texture_data"]
for k, v in it.items():
    if not os.path.exists(f"{rp}/{v['textures']}.png"): bad.append(f"ikon '{k}' saknar fil")
for f in glob.glob(f"{rp}/entity/*.json"):
    e = json.load(open(f))["minecraft:client_entity"]["description"]
    t = e.get("spawn_egg", {}).get("texture")
    if t and t not in it: bad.append(f"{os.path.basename(f)}: spawn_egg '{t}' saknas i atlasen")
    tex = e["textures"]["default"]
