#!/bin/bash
# Bygg → testa → paketera → skicka till Mod Mate, i ett kommando.
# Vägrar skicka om purrfect-test hittar fel. Skapad 2026-08-07.
#
# Användning:  purrfect-ship                 # testa + paketera + ladda upp
#              purrfect-ship --bump minor    # höj version (major|minor|patch) först
#              purrfect-ship --no-upload     # bygg + testa, men skicka inte
set -u
SRC=/opt/purrfect-companions
CODE_FILE=/opt/purrfect-companions/.modmate-code
BUMP=""; UPLOAD=1; VARIANT="private"; CURSEFORGE=0
CF_TOKEN_FILE=/opt/purrfect-companions/.curseforge-token
CF_PROJECT=1643319
CF_GAMEVERSION=6952   # Bedrock "1.0" - enda versionen i deras API
while [ $# -gt 0 ]; do
  case "$1" in
    --bump)
      case "${2:-}" in major|minor|patch) BUMP="$2"; shift 2;; *) BUMP=patch; shift;; esac;;
    --no-upload) UPLOAD=0; shift;;
    --variant) VARIANT="${2:-private}"; shift 2;;
    --curseforge) CURSEFORGE=1; VARIANT="public"; shift;;
    --public) VARIANT="public"; shift;;
    *) echo "okänt argument: $1"; exit 1;;
  esac
done
case "$VARIANT" in private|public) ;; *) echo "variant måste vara private eller public"; exit 1;; esac

if [ -n "$BUMP" ]; then
  python3 - "$SRC" "$BUMP" <<'PY'
import json,sys
SRC,kind=sys.argv[1],sys.argv[2]
BP=f"{SRC}/PurrfectCompanions_BP/manifest.json"; RP=f"{SRC}/PurrfectCompanions_RP/manifest.json"
bp=json.load(open(BP)); rp=json.load(open(RP))
v=list(bp["header"]["version"])
i={"major":0,"minor":1,"patch":2}[kind]
v[i]+=1
for j in range(i+1,3): v[j]=0
for m in (bp,rp):
    m["header"]["version"]=v
    for mod in m["modules"]: mod["version"]=v
for d in bp.get("dependencies",[]):
    if d.get("uuid")==rp["header"]["uuid"]: d["version"]=v
json.dump(bp,open(BP,"w"),indent=2); json.dump(rp,open(RP,"w"),indent=2)
print("ny version: "+".".join(map(str,v)))
PY
fi

VER=$(python3 -c "import json;print('.'.join(map(str,json.load(open('$SRC/PurrfectCompanions_BP/manifest.json'))['header']['version'])))")

echo "=== testar v$VER ($VARIANT) innan leverans ==="
if ! purrfect-test; then
  echo
  echo "❌ TESTET FAILADE — skickar INTE. Fixa felen och kör igen."
  exit 1
fi

# Källan är den PUBLIKA versionen; privata namn appliceras på en kopia vid bygget.
STAGE="/tmp/purrfect-stage-$VARIANT"
python3 "$SRC/make_variant.py" "$VARIANT" "$STAGE" | sed 's/^/   /'
# Filnamnet härleds ur paketnamnet i manifestet → följer automatiskt med vid namnbyte
SLUG=$(python3 -c "
import json,re
n=json.load(open('$SRC/PurrfectCompanions_BP/manifest.json'))['header']['name']
print(re.sub(r'[^a-z0-9]+','-',n.lower()).strip('-'))")
SUFFIX=""; [ "$VARIANT" = "private" ] && SUFFIX="-familj"
OUT="/tmp/$SLUG-v$VER$SUFFIX.mcaddon"
rm -f "$OUT"
( cd "$STAGE" && zip -r -q "$OUT" PurrfectCompanions_BP PurrfectCompanions_RP )
SHA=$(sha256sum "$OUT" | cut -d' ' -f1)
echo
echo "📦 paketerad: $(basename "$OUT") ($(du -h "$OUT" | cut -f1))"

# Två filer med samma pack-uuid OCH samma version men olika innehåll får
# Minecraft att vägra ladda den ena — "at least one of your behaviour packs
# failed to load". Det hände v2.3.1. Loggboken gör om det till ett stopp.
LEDGER=/opt/purrfect-companions/.shipped.tsv
# Zip-arkiv är inte reproducerbara (tidsstämplar), så arkivets sha duger inte
# för att avgöra om innehållet ändrats. Hasha filerna i stället.
CONTENT_SHA=$(cd "$STAGE" && find . -type f | LC_ALL=C sort | xargs sha256sum | sha256sum | cut -d" " -f1)
if PREV=$(grep -P "^$VER\t$VARIANT\t" "$LEDGER" 2>/dev/null | tail -1 | cut -f3); [ -n "$PREV" ]; then
  if [ "$PREV" != "$CONTENT_SHA" ]; then
    echo "❌ v$VER ($VARIANT) är redan utskickad med ANNAT innehåll"
    echo "   tidigare: $PREV"
    echo "   nu:       $CONTENT_SHA"
    echo "   Höj versionen (--bump patch) — skicka aldrig samma version två gånger."
    exit 1
  fi
  echo "   (samma innehåll som redan utskickad v$VER — skickar om)"
fi

if [ "$CURSEFORGE" -eq 1 ]; then
  # Pelle 2026-08-09: CF-användarna klagar på för täta updates —
  # ENDAST major-versioner (X.0.0) får skickas till CurseForge.
  case "$VER" in
    *.0.0) ;;
    *) echo "⛔ endast major (X.0.0) till CurseForge — $VER är ingen major"; exit 1;;
  esac
  [ -f "$CF_TOKEN_FILE" ] || { echo "❌ ingen CurseForge-token i $CF_TOKEN_FILE"; exit 1; }
  CHANGELOG=$(cat /opt/purrfect-companions/publish/changelog.md 2>/dev/null || echo "Update $VER")
  # metadata via FIL — skalcitering bryter sönder JSON med radbrytningar/citattecken
  METAFILE=/tmp/cf-metadata.json
  python3 - "$VER" "$CF_GAMEVERSION" "$METAFILE" <<'PYMETA'
import json, sys
ver, gv, out = sys.argv[1], int(sys.argv[2]), sys.argv[3]
meta = {"changelog": open("/opt/purrfect-companions/publish/changelog.md", encoding="utf-8").read(),
        "changelogType": "markdown",
        "displayName": f"Purrfect Companions {ver}",
        "releaseType": "release"}
# OBS: gameVersions ska INTE skickas för Bedrock-projekt — API:et svarar
# "Invalid game version ID ... belongs to an invalid game". Java-projekt kräver det.
json.dump(meta, open(out, "w", encoding="utf-8"))
print(f"   metadata: {len(meta['changelog'])} tecken changelog (inga gameVersions - Bedrock)")
PYMETA
  echo "☁️  laddar upp till CurseForge-projekt $CF_PROJECT ..."
  RESP=$(curl -s --max-time 180 -X POST \
    -H "X-Api-Token: $(cat $CF_TOKEN_FILE)" \
    -F "metadata=<$METAFILE" -F "file=@$OUT" \
    "https://bedrock.curseforge.com/api/projects/$CF_PROJECT/upload-file")
  echo "   svar: $RESP"
  echo "$RESP" | grep -q '"id"' && echo "✅ uppladdad till CurseForge" || { echo "❌ CurseForge-uppladdning misslyckades"; exit 1; }
  printf '%s\t%s\t%s\n' "$VER" "$VARIANT" "$CONTENT_SHA" >> "$LEDGER"
  exit 0
fi

[ "$UPLOAD" -eq 0 ] && { echo "(--no-upload: hoppar över Mod Mate)"; exit 0; }

if [ ! -f "$CODE_FILE" ]; then
  echo "❌ ingen Mod Mate-kod sparad. Lägg transfer-koden i $CODE_FILE"
  exit 1
fi
CODE=$(tr -d '[:space:]' < "$CODE_FILE")
RESP=$(curl -s --max-time 120 -X POST -F "file=@$OUT;type=application/octet-stream" \
  "https://modmate.dev/ModMateTransfer/upload?code=$CODE")
echo "☁️  Mod Mate: $RESP"
if echo "$RESP" | grep -q "$SHA"; then
  echo "✅ checksumma verifierad — filen kom fram intakt"
  printf '%s\t%s\t%s\n' "$VER" "$VARIANT" "$CONTENT_SHA" >> "$LEDGER"
else
  echo "⚠️  checksumman i svaret matchar inte lokal fil ($SHA) — kontrollera manuellt"
  exit 1
fi
