  echo "setblock 26 20 20 air"; sleep 1
  echo "setblock 28 20 20 air"; sleep 1
  echo "setblock 20 20 20 mjau:kattbadd"; sleep 1
  echo "setblock 22 20 20 mjau:garnnystan"; sleep 1
  echo "setblock 24 20 20 mjau:matskal"; sleep 1
  echo "setblock 26 20 20 mjau:kattoa"; sleep 1
  echo "setblock 28 20 20 mjau:stallning"; sleep 1
  sleep 2; echo "stop"; sleep 8
} | LD_LIBRARY_PATH=. ./bedrock_server > "$LOG" 2>&1
