#!/bin/bash
# Utvecklingsupplägg för Purrfect Companions (Minecraft Bedrock-add-on).
# Validerar källan och kör den skarpt i en riktig Bedrock-server: spawnar alla
# katter och avfyrar mod-händelserna, så man ser om något gått sönder INNAN
# filen skickas till Xbox. Servern startas bara under testet och stoppas efter
# (den får inte ligga och äta RAM på LXC 102 där Rocket.Chat m.fl. kör).
#
# Användning:  purrfect-test           # full validering + live-test (~1 min)
#              purrfect-test --quick   # bara validering, ingen server (~2 s)
# Exit 0 = allt grönt, 1 = något fel. Skapad 2026-08-07.
set -u
# EN Bedrock-server åt gången — vänta på låset i stället för att krocka på portarna.
# Ärftligt: barnprocesser (gametest) ska INTE ta låset igen — självdeadlock annars.
if [ "${BDS_LOCK_HELD:-}" != "1" ]; then
  exec 9>/tmp/bds.lock; flock -w 1200 9 || { echo "kunde inte ta serverlåset"; exit 1; }
  export BDS_LOCK_HELD=1
fi
SRC=/opt/purrfect-companions
SRV=/opt/bds/server
WORLD="$SRV/worlds/Kattest"
LOG=/tmp/purrfect-test.log
CATS="misty hazel mocha snow ginger domino"
EVENTS="mjau:on_tame mjau:on_sadel_1 mjau:on_keps_2 mjau:on_halsduk_2 mjau:on_ryggsack_3 mjau:on_glasogon_2 mjau:on_mantel_3 mjau:on_tossor_2 mjau:on_vagn_1 mjau:on_horn_1 mjau:on_rustning_1 mjau:on_matad minecraft:entity_born mjau:grow_up"
FAIL=0
ok(){ echo "  ✅ $1"; }
bad(){ echo "  ❌ $1"; FAIL=1; }

echo "=== Purrfect Companions test $(date '+%F %H:%M') ==="
[ -d "$SRC/PurrfectCompanions_BP" ] || { echo "hittar inte källan i $SRC"; exit 1; }

echo
echo "[1/4] JSON-validering"
n=0; badjson=0
while read -r f; do
  n=$((n+1))
  python3 -c "import json;json.load(open('$f'))" 2>/dev/null || { bad "ogiltig JSON: ${f#$SRC/}"; badjson=1; }
done < <(find "$SRC" -name "*.json")
[ $badjson -eq 0 ] && ok "$n filer giltiga"

echo
# PNG-KOLL först: en trasig bild ser exakt ut som en fungerande i alla andra
# kontroller — filen finns, item_texture.json pekar rätt, JSON:en är giltig —
# och syns först som rutmönster på konsolen.
if ! python3 "$SRC/tools/pngkoll.py" "$SRC/PurrfectCompanions_RP" "$SRC/PurrfectHarbour_RP" | sed 's/^/  /'; then
  bad "trasiga PNG-filer i resurspaketen"
fi

echo "[2/4] Struktur & kända fallgropar"
python3 - "$SRC" > /tmp/purrfect-struct.txt 2>/tmp/purrfect-struct.err <<'PY'
import json,glob,os,re,sys
sys.path.insert(0, "/opt/purrfect-companions")
import render_regression as rr
from collections import Counter as _Counter
SRC=sys.argv[1]; bad=[]
bp=json.load(open(f"{SRC}/PurrfectCompanions_BP/manifest.json")); rp=json.load(open(f"{SRC}/PurrfectCompanions_RP/manifest.json"))
V=bp["header"]["version"]
if rp["header"]["version"]!=V: bad.append("RP-version != BP-version")
if any(m["version"]!=V for m in bp["modules"]+rp["modules"]): bad.append("modul-version != header-version")
dep=[d for d in bp.get("dependencies",[]) if d.get("uuid")==rp["header"]["uuid"]]
if not dep: bad.append("BP saknar beroende till RP")
elif dep[0]["version"]!=rp["header"]["version"]: bad.append("beroende-version != RP-version")
GEOALL=json.load(open(f"{SRC}/PurrfectCompanions_RP/models/entity/katt.geo.json"))["minecraft:geometry"]
# Texturstorleken i VARJE geometri måste matcha den faktiska PNG-filen, annars
# läses UV i fel skala och modellen blir obegriplig i spelet (servern märker inget).
import struct as _st
_d=open(f"{SRC}/PurrfectCompanions_RP/textures/entity/misty.png","rb").read()
_tw,_th=_st.unpack(">II",_d[16:24])
for _g in GEOALL:
    _dsc=_g["description"]
    if (_dsc.get("texture_width"),_dsc.get("texture_height"))!=(_tw,_th):
        bad.append(f"{_dsc['identifier']}: texturstorlek {_dsc.get('texture_width')}x{_dsc.get('texture_height')} != PNG {_tw}x{_th}")
GEOIDS={g["description"]["identifier"] for g in GEOALL}

# KATTDRÄKTEN (3.28.0) ritas på SPELAREN via attachables, och där kan tre fel
# göra plagget osynligt eller trasigt utan att servern säger något:
#   * geometrin eller texturen som pekas ut finns inte
#   * texturstorleken i geometrin stämmer inte med PNG:en (UV i fel skala)
#   * bennamnen är inte spelarskelettets — plagget hamnar då i marken
# Alla tre syns först på en skärm, precis som vakthundens lossnade huvud.
SPELARBEN={"head","body","leftArm","rightArm","leftLeg","rightLeg"}
for _af in sorted(glob.glob(f"{SRC}/PurrfectCompanions_RP/attachables/*.json")):
    _a=json.load(open(_af))["minecraft:attachable"]["description"]
    _namn=os.path.basename(_af)
    for _gid in _a.get("geometry",{}).values():
        _gf=f"{SRC}/PurrfectCompanions_RP/models/entity/{_gid.replace('geometry.','')}.geo.json"
        if not os.path.exists(_gf):
            bad.append(f"{_namn}: geometri {_gid} finns inte"); continue
        _g=json.load(open(_gf))["minecraft:geometry"][0]
        _tex=f"{SRC}/PurrfectCompanions_RP/{_a['textures']['default']}.png"
        if not os.path.exists(_tex):
            bad.append(f"{_namn}: textur {_a['textures']['default']} saknas"); continue
        _td=open(_tex,"rb").read(); _tw2,_th2=_st.unpack(">II",_td[16:24])
        _d2=_g["description"]
        if (_d2.get("texture_width"),_d2.get("texture_height"))!=(_tw2,_th2):
            bad.append(f"{_namn}: texturstorlek {_d2.get('texture_width')}x{_d2.get('texture_height')} != PNG {_tw2}x{_th2}")
        for _b in _g["bones"]:
            if _b["name"] not in SPELARBEN:
                bad.append(f"{_namn}: benet '{_b['name']}' finns inte i spelarskelettet")
# Bärbara föremål måste ha en ikon som är registrerad, annars är rutan tom
for _if in sorted(glob.glob(f"{SRC}/PurrfectCompanions_BP/items/*.json")):
    _i=json.load(open(_if))["minecraft:item"]
    if "minecraft:wearable" not in _i["components"]: continue
    _slot=_i["components"]["minecraft:wearable"].get("slot","")
    if not _slot.startswith("slot.armor."):
        bad.append(f"{os.path.basename(_if)}: wearable utan giltig rustningsplats ({_slot})")

# HUNDEN har egen geometri och egen textur sedan 3.27.0. Samma två kontroller
# som katten får, plus en tredje som är hela anledningen till att hon byggdes
# om: klientdefinitionen animerar BENNAMN, och animeras ett ben som inte finns
# i geometrin hamnar kroppsdelen någon annanstans — precis så föll vaniljas
# varg isär hos oss (look_at_target roterade ett "head" som satt i en
# upperBody-hierarki vi inte ägde). Servern säger ingenting; det syns först på
# en konsol.
BENKRAV={"animation.common.look_at_target":["head"],
         "animation.quadruped.walk":["leg0","leg1","leg2","leg3"]}
_hp=f"{SRC}/PurrfectCompanions_RP/models/entity/hund.geo.json"
if os.path.exists(_hp):
    for _g in json.load(open(_hp))["minecraft:geometry"]:
        _dsc=_g["description"]; GEOIDS.add(_dsc["identifier"])
        _tex=f"{SRC}/PurrfectCompanions_RP/textures/entity/hund.png"
        _hd=open(_tex,"rb").read(); _hw,_hh=_st.unpack(">II",_hd[16:24])
        if (_dsc.get("texture_width"),_dsc.get("texture_height"))!=(_hw,_hh):
            bad.append(f"{_dsc['identifier']}: texturstorlek {_dsc.get('texture_width')}x{_dsc.get('texture_height')} != PNG {_hw}x{_hh}")
        _ben={b["name"] for b in _g["bones"]}
        for _cf in glob.glob(f"{SRC}/PurrfectCompanions_RP/entity/*.json"):
            _cd=json.load(open(_cf))["minecraft:client_entity"]["description"]
            if _dsc["identifier"] not in _cd.get("geometry",{}).values(): continue
            for _anim in _cd.get("animations",{}).values():
                for _krav in BENKRAV.get(_anim,[]):
                    if _krav not in _ben:
                        bad.append(f"{os.path.basename(_cf)}: {_anim} animerar benet '{_krav}' som {_dsc['identifier']} saknar")
geoj=GEOALL[0]
geo=geoj["description"]["identifier"]; body_top=None; body_back=None
# render controllers som client_entity refererar måste finnas
import glob as _g
RCS=set()
for rf in _g.glob(f"{SRC}/PurrfectCompanions_RP/render_controllers/*.json"):
    RCS|=set(json.load(open(rf)).get("render_controllers",{}).keys())
# egna föremål: ikon måste vara registrerad
ITEX=json.load(open(f"{SRC}/PurrfectCompanions_RP/textures/item_texture.json")).get("texture_data",{}) if os.path.exists(f"{SRC}/PurrfectCompanions_RP/textures/item_texture.json") else {}
for itf in _g.glob(f"{SRC}/PurrfectCompanions_BP/items/*.json"):
    ic=json.load(open(itf))["minecraft:item"]["components"].get("minecraft:icon",{})
    t=ic.get("texture")
    if t and t not in ITEX: bad.append(f"föremål {os.path.basename(itf)}: ikon '{t}' saknas i item_texture.json")
    elif t and not os.path.exists(f"{SRC}/PurrfectCompanions_RP/{ITEX[t]['textures']}.png"):
        bad.append(f"föremål {os.path.basename(itf)}: ikonfil saknas")
for b in geoj["bones"]:
    if b["name"]=="body":
        c=b["cubes"][0]; body_top=c["origin"][1]+c["size"][1]
        body_back=c["origin"][2]+c["size"][2]
for f in glob.glob(f"{SRC}/PurrfectCompanions_RP/entity/*.json"):
    d=json.load(open(f))["minecraft:client_entity"]["description"]
    for key,gid in d["geometry"].items():
        if gid.startswith("geometry.katt") and gid not in GEOIDS:
            bad.append(f"{os.path.basename(f)}: geometri '{gid}' ({key}) finns inte i katt.geo.json")
    for rc in d.get("render_controllers",[]):
        if isinstance(rc,str) and rc not in RCS and not rc.startswith("controller.render.default"):
            bad.append(f"{os.path.basename(f)}: render controller '{rc}' saknas")
    if not d["textures"]["default"].startswith("textures/entity/") and \
       not os.path.exists(f"{SRC}/PurrfectCompanions_RP/{d['textures']['default']}.png"):
        bad.append(f"saknad textur för {os.path.basename(f)}")
    egg=d.get("spawn_egg",{})
    if "texture" in egg:
        it=f"{SRC}/PurrfectCompanions_RP/textures/item_texture.json"
        if not os.path.exists(it): bad.append("spawn_egg använder texture men item_texture.json saknas")
        else:
            td=json.load(open(it)).get("texture_data",{})
            if egg["texture"] not in td: bad.append(f"spawn_egg-textur '{egg['texture']}' saknas i item_texture.json")
            elif not os.path.exists(f"{SRC}/PurrfectCompanions_RP/{td[egg['texture']]['textures']}.png"):
                bad.append(f"spawn-ikon-fil saknas för {egg['texture']}")
for f in sorted(glob.glob(f"{SRC}/PurrfectCompanions_BP/entities/*.json")):
    cid=os.path.basename(f)[:-5]; e=json.load(open(f))["minecraft:entity"]
    comp=e["components"]; groups=e.get("component_groups",{})
    # KATTREGLERNA (rustning, ridning, kattgeometri) gäller bara kattfamiljen —
    # andra varelser (vakthunden) granskas bara för prioritetskrockar
    ar_katt = "mjaukatt" in comp.get("minecraft:type_family",{}).get("family",[])
    pri={}
    for bk in [comp]+list(groups.values()):
        for k,v in bk.items():
            if k.startswith("minecraft:behavior.") and isinstance(v,dict):
                pri.setdefault(v.get("priority"),[]).append(k.split(".")[-1])
    dup={p:v for p,v in pri.items() if len(v)>1}
    if dup: bad.append(f"{cid}: prioritetskrock {dup}")
    if not ar_katt: continue
    if "minecraft:scale" in comp and any("minecraft:scale" in g for g in groups.values()):
        bad.append(f"{cid}: scale i både bas och grupp")
    sad=groups.get("mjau:saddled",{})
    if sad and body_top:
        seats=sad["minecraft:rideable"]["seats"]
        first=seats[0] if isinstance(seats,list) else seats     # 1 plats = dict, flera = lista
        seat=first["position"][1]
        if abs(seat-body_top/16)>0.08:
            bad.append(f"{cid}: sadelhojd {seat} != kroppens topp {round(body_top/16,3)}")
    # Sätets djupled (z): UPPMÄTT i gametest 2026-08-08 — sätets +z pekar MOT
    # HUVUDET (ryttare på seat z=+0.15 landade forward=+0.15 i kattens eget
    # koordinatsystem). 2.6.1 antog motsatt tecken och satte ryttaren på
    # skallen. Kräv bakre kroppshalvan: -(body_back/16) <= z <= -0.1.
    if body_back is not None:
        for gname,grp in groups.items():
            rd=grp.get("minecraft:rideable")
            if not rd: continue
            seats2=rd["seats"]; seats2=seats2 if isinstance(seats2,list) else [seats2]
            for si,s in enumerate(seats2):
                if gname=="mjau:carted" and si==0: continue   # säte 0 sitter I vagnen, inte på katten
                z=s["position"][2]
                if not (-(body_back/16)-0.05 <= z <= -0.1):
                    bad.append(f"{cid}: {gname} säte {si} z={z} utanför bakre kroppshalvan "
                               f"(kräver {round(-(body_back/16)-0.05,3)} <= z <= -0.1; +z = mot huvudet)")
    # Fallskada vid ridning: RIDDJURET tar fallskadan, så utan en damage_sensor
    # som nollar 'fall' dör katten när man hoppar/glidflyger ner. Live-testet
    # hoppar bara på plan mark och missar det helt.
    for gname,grp in groups.items():
        if "minecraft:rideable" not in grp: continue
        trigs=grp.get("minecraft:damage_sensor",{}).get("triggers",[])
        trigs=trigs if isinstance(trigs,list) else [trigs]
        if not any(t.get("cause")=="fall" and t.get("deals_damage") in (False,"no")
                   for t in trigs):
            bad.append(f"{cid}: {gname} är rideable men saknar damage_sensor som "
                       f"nollar fallskada")
    # 'nap' fick katterna att lägga sig och sova direkt vid spawn — de "bara låg".
    # Vanilla-katter tar inte tupplur; behålls beteendet ser mobben livlös ut.
    for bk in [comp]+list(groups.values()):
        if "minecraft:behavior.nap" in bk:
            bad.append(f"{cid}: behavior.nap får katten att bara ligga och sova")
    # Ett riddjur får inte styra sig självt: varje beteende som FLYTTAR katten
    # på eget initiativ måste ligga i en grupp som varje sadel-/vagn-event tar
    # bort. 2.5.0 lovade detta i commit-texten men ingen event tog bort mjau:fri
    # — random_stroll triggar slumpvis, så gametestets driftmätning var grön i
    # 2 körningar av 3 och buggen nådde spelarna ändå. Statisk check är
    # deterministisk där livetestet är ett stickprov.
    _self_moving=["minecraft:behavior.nearest_attackable_target",
                  "minecraft:behavior.random_stroll",
                  "minecraft:behavior.tempt",
                  "minecraft:behavior.move_to_block",
                  "minecraft:behavior.random_sitting"]
    for _b in _self_moving:
        if _b in comp:
            bad.append(f"{cid}: {_b.split('.')[-1]} i bas-components — går inte att stänga av vid ridning")
    _hg={g for g,v in groups.items() if any(_b in v for _b in _self_moving)}
    for evn,evd in e.get("events",{}).items():
        adds=evd.get("add",{}).get("component_groups",[])
        if "mjau:saddled" in adds or "mjau:carted" in adds:
            _miss=_hg-set(evd.get("remove",{}).get("component_groups",[]))
            if _miss:
                bad.append(f"{cid}: event {evn} sätter riddjuret utan att ta bort "
                           f"självgående grupp {sorted(_miss)} — katten styr sig själv under ridning")
    # Rustning: nivågrupperna ska finnas och ge mer liv ju bättre material —
    # och alla ska ge mer än basen, annars är pansaret ren kosmetik.
    _base=comp.get("minecraft:health",{}).get("value",0)
    _prev=_base
    for _i in (1,2,3,4):
        _ag=groups.get(f"mjau:armored_{_i}")
        if not _ag or "minecraft:health" not in _ag:
            bad.append(f"{cid}: rustningsgrupp mjau:armored_{_i} saknas/saknar hälsa"); continue
        _hv=_ag["minecraft:health"]["value"]
        if _hv<=_prev:
            bad.append(f"{cid}: armored_{_i} hälsa {_hv} skalar inte upp (föregående {_prev})")
        _prev=_hv
    # Legacy: <=2.6.1-världar bär "mjau:armored" i sparad data. Försvinner
    # definitionen kan katten bli okänd aktör vid uppgradering (2.6.2-läxan).
    if "mjau:armored" not in groups:
        bad.append(f"{cid}: legacy-gruppen mjau:armored saknas — äldre världar tappar katten")
    for _i in (1,2,3,4):
        _evd=e.get("events",{}).get(f"mjau:on_rustning_{_i}",{})
        _adds=_evd.get("add",{}).get("component_groups",[])
        _rems=set(_evd.get("remove",{}).get("component_groups",[]))
        if f"mjau:armored_{_i}" not in _adds:
            bad.append(f"{cid}: on_rustning_{_i} lägger inte till armored_{_i}")
        _saknas={f"mjau:armored_{_j}" for _j in (1,2,3,4) if _j!=_i}|{"mjau:armored"}
        _saknas-=_rems
        if _saknas:
            bad.append(f"{cid}: on_rustning_{_i} tar inte bort {sorted(_saknas)} — "
                       f"gammal hälsogrupp ligger kvar vid rustningsbyte")
    # Namnnycklar: Bedrock slår upp entitetsnamn både MED och UTAN namespace
    # (vanilla: entity.pig.name). Saknas kortformen visar t.ex. lastutrymmets
    # rubrik "Unknown". Kräv båda formerna i varje språkfil i RP:n.
    _cef2=f"{SRC}/PurrfectCompanions_RP/entity/{cid}.json"
    _has_egg=os.path.exists(_cef2) and "spawn_egg" in json.load(open(_cef2))["minecraft:client_entity"]["description"]
    for _lf in glob.glob(f"{SRC}/PurrfectCompanions_RP/texts/*.lang"):
        _lt=open(_lf,encoding="utf-8").read()
        _keys=[f"entity.mjau:{cid}.name=",f"entity.{cid}.name="]
        if _has_egg: _keys.append(f"item.spawn_egg.entity.mjau:{cid}.name=")
        for _k in _keys:
            if _k not in _lt:
                bad.append(f"{cid}: nyckeln {_k[:-1]} saknas i {os.path.basename(_lf)}")
    # Två styrsystem på samma riddjur slåss: controlled_by_player är ett AI-mål
    # som driver entiteten mot ryttarens blick, input_ground_controlled är
    # spelarens direkta spakinmatning. Ligger AI-målet på prio 0 vinner det varje
    # tick och styrningen känns död.
    for gname,grp in groups.items():
        if "minecraft:input_ground_controlled" in grp and "minecraft:behavior.controlled_by_player" in grp:
            bad.append(f"{cid}: {gname} har BÅDE input_ground_controlled och "
                       f"controlled_by_player — AI-målet kör över spelarens styrning")
    # Flera ridlägen är OK BARA om de utesluter varandra: varje event som
    # lägger till ett måste ta bort de andra, annars kan två rideable vara
    # aktiva samtidigt (odefinierat vilken som vinner).
    ride=[k for k,v in groups.items() if "minecraft:rideable" in v]
    if len(ride)>1:
        for evn,evd in e.get("events",{}).items():
            adds=evd.get("add",{}).get("component_groups",[])
            rems=evd.get("remove",{}).get("component_groups",[])
            for grp in ride:
                if grp in adds:
                    others=[o for o in ride if o!=grp and o not in rems]
                    if others:
                        bad.append(f"{cid}: event {evn} aktiverar {grp} utan att ta bort {others}")
    if "minecraft:behavior.follow_owner" in comp:
        bad.append(f"{cid}: follow_owner i bas-components (kraver agare)")
    # RITUALKATTERNA kommer bara via sin ritual och får därför inte ha
    # spawn_rules — då vore de inte hemliga.
    #
    # Listan är EXPLICIT sedan 3.27.2. Förut lästes hemligheten ur att katten
    # saknade spawn_egg, och det var fel proxy: de fyra syntes ändå i
    # kreativlistan (is_spawnable), fast som svarta standardägg, vilket
    # rapporterades från Xbox med orden "de ska ha bilder". När de fick sina
    # ansikten började kontrollen kräva spawn_rules av dem. Hemligheten sitter
    # i att de aldrig dyker upp av sig själva i världen — inte i hur de ser ut
    # i inventariet.
    RITUALKATTER={"midnight","aurora","nova","spokkatt"}
    if cid in RITUALKATTER:
        if os.path.exists(f"{SRC}/PurrfectCompanions_BP/spawn_rules/{cid}.json"):
            bad.append(f"{cid}: ritualkatt med spawn_rules — då är hon inte hemlig")
    elif not os.path.exists(f"{SRC}/PurrfectCompanions_BP/spawn_rules/{cid}.json"):
        bad.append(f"{cid}: saknar spawn_rules")
    # has_equipment-filtren: EGNA föremål måste anges med full identifierare
    # (mjau:sadel_brun), annars matchar filtret aldrig och plagget går inte att
    # sätta på. Testet avfyrar events direkt och hoppar över filtren, så det här
    # är enda stället felet fångas.
    own={json.load(open(p))["minecraft:item"]["description"]["identifier"]
         for p in _g.glob(f"{SRC}/PurrfectCompanions_BP/items/*.json")}
    shortnames={i.split(":",1)[1] for i in own}
    for grp in groups.values():
        for inter in grp.get("minecraft:interact",{}).get("interactions",[]):
            for filt in inter.get("on_interact",{}).get("filters",{}).get("all_of",[]):
                if filt.get("test")=="has_equipment":
                    v=filt.get("value","")
                    if ":" not in v and v in shortnames:
                        bad.append(f"{cid}: has_equipment '{v}' saknar namnrymd - ska vara 'mjau:{v}'")
                    elif ":" in v and v not in own:
                        bad.append(f"{cid}: has_equipment '{v}' matchar inget föremål")
    # En property som render controllers läser MÅSTE ha client_sync — annars finns
    # den bara på servern och plagget syns aldrig, trots att allt annat fungerar.
    _rcs=open(f"{SRC}/PurrfectCompanions_RP/render_controllers/katt.render_controllers.json",encoding="utf-8").read()
    for pname,pdef in e["description"].get("properties",{}).items():
        if f"query.property('{pname}')" in _rcs and not pdef.get("client_sync"):
            bad.append(f"{cid}: property '{pname}' läses av en render controller men saknar client_sync")
    # interact_text måste finnas i lang-filen, annars visar spelet nyckeln i
