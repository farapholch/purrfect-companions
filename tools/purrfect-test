  echo "kill @e[type=mjau:hazel]"; sleep 1
  echo "time set day"; sleep 1
  # BLOCK-test: går de att placera? (verifierar registrering + geometri)
  # rensa först - världen sparas mellan körningar, och setblock på ett redan
  # identiskt block räknas inte som placerat
  echo "setblock 20 20 20 air"; sleep 1
  echo "setblock 22 20 20 air"; sleep 1
  echo "setblock 24 20 20 air"; sleep 1
  echo "setblock 26 20 20 air"; sleep 1
  echo "setblock 28 20 20 air"; sleep 1
  echo "setblock 20 20 20 mjau:kattbadd"; sleep 1
  echo "setblock 22 20 20 mjau:garnnystan"; sleep 1
  echo "setblock 24 20 20 mjau:matskal"; sleep 1
  echo "setblock 26 20 20 mjau:kattoa"; sleep 1
  echo "setblock 28 20 20 mjau:stallning"; sleep 1
  sleep 2; echo "stop"; sleep 8
} | LD_LIBRARY_PATH=. ./bedrock_server > "$LOG" 2>&1
pkill -9 -x bedrock_server 2>/dev/null

# läs paketnamnet ur manifestet i stället för att hårdkoda det
PACKNAME=$(python3 -c "import json;print(json.load(open('$SRC/PurrfectCompanions_BP/manifest.json'))['header']['name'])")
LOADED=$(grep -c "Pack Stack.*$PACKNAME" "$LOG")
SUM=$(grep -c "Object successfully summoned" "$LOG")
EVOK=$(grep -c "successfully executed on: mjau:" "$LOG")
PROPOK=$(grep -c "Found entity.mjau:misty" "$LOG")
ARMOK=$(grep -c "Found entity.mjau:snow" "$LOG")
BLOCKOK=$(grep -c "Block placed" "$LOG")
CARGO=$(grep -ci "Replaced slot" "$LOG")
VAKUUM=$(grep -c "VAKUUM-TEST OK" "$LOG")
NYRAS=$(grep -cE "Found entity\.mjau:(ginger|domino)" "$LOG")
KOLONI=$(grep -c "KOLONI-TEST OK" "$LOG")
SOVHOG=$(grep -c "Found entity.mjau:hazel" "$LOG")
HUNGER=$(grep -c "Found Hungertest" "$LOG")
HUND=$(grep -c "Found entity.mjau:vakthund" "$LOG")
# Syntax-/komponentfel är ALLTID allvarliga. "Unable to summon" kan vara flakigt
# för första spawnen precis när tickingarea laddas → tolerera högst 1.
HARD=$(grep -ciE "Syntax error|unknown component|invalid" "$LOG")
SOFT=$(grep -c "Unable to summon" "$LOG")
[ "$LOADED" -ge 1 ] && ok "paketet \"$PACKNAME\" laddades (v$VER)" || bad "paketet \"$PACKNAME\" laddades INTE"
[ "$SUM" -ge 7 ] && ok "spawns: $SUM/7 (gris + 6 katter)" || bad "spawns: $SUM/7"
[ "$EVOK" -ge 14 ] && ok "händelser: $EVOK/14 (tämjning, 10 plagg+godis inkl vagn+horn+rustning, födsel, uppväxt)" || bad "händelser: $EVOK/14"
[ "$HARD" -eq 0 ] && ok "inga syntax-/komponentfel" || bad "$HARD allvarliga fel (se $LOG)"
[ "$PROPOK" -ge 10 ] && ok "plaggen ändrar kattens tillstånd: $PROPOK/10 (has_property)" || bad "bara $PROPOK/10 plagg satte sin property"
[ "$BLOCKOK" -ge 5 ] && ok "blocken går att placera: $BLOCKOK/5" || bad "blocken kunde inte placeras ($BLOCKOK/5)"
[ "$CARGO" -ge 2 ] && ok "vagn OCH ryggsäck har riktiga lastutrymmen ($CARGO/2 replaceitem i slot.inventory)" || bad "förvaringen gick inte att fylla ($CARGO/2) — is_chested/inventory verkar inte ge någon container"
[ "$VAKUUM" -ge 1 ] && ok "ryggsäckskatten plockar upp från marken (skriptkroken hittade tråden i väskan)" || bad "ryggsäckskatten plockade INTE upp tråden (se VAKUUM-TEST i $LOG)"
[ "$HUND" -ge 1 ] && ok "vakthunden laddar med egen geometri" || bad "vakthunden gick inte att spawna"
[ "$NYRAS" -ge 4 ] && ok "Ginger och Domino bär plaggen: $NYRAS/4 (sadel + ryggsäck, has_property)" || bad "de nya raserna satte bara $NYRAS/4 plagg-properties"
[ "$KOLONI" -ge 1 ] && ok "kolonin: katterna tvättar varandra och kryper ihop på natten" || bad "kolonin fungerade inte (se KOLONI-TEST i $LOG)"
[ "$HUNGER" -ge 3 ] && ok "hungern pausar bonusarna, maten höjer humöret och skriptet speglar tillbaka ($HUNGER/3)" || bad "hungerspeglingen gav $HUNGER/3"
[ "$SOVHOG" -ge 1 ] && ok "sovhögen är observerbar server-side (mjau:sover=1 driver sovposen)" || bad "ingen katt fick mjau:sover=1"
[ "$ARMOK" -ge 1 ] && ok "netheritrustningen ger extra liv (överlevde 45 skada)" || bad "rustningsnivån gav inte extra liv — 45 skada dödade katten"
if [ "$SOFT" -eq 0 ]; then
  ok "inga misslyckade spawns"
elif [ "$SOFT" -le 1 ]; then
  echo "  ℹ️  1 flakig spawn vid uppstart (tolereras)"
else
  bad "$SOFT misslyckade spawns"
fi
CL=$(find "$SRV" -name "ContentLog*" 2>/dev/null | head -1)
# ContentLog samlar ALL skriptutskrift, även [inform]. Grinden ska falla på
# VARNINGAR OCH FEL, inte på kvitton: paketet skriver medvetet ut rader när
# något gick rätt till (vakuumkroken, Befriaren när vakthunden fälls), och de
# raderna gjorde körningen röd fast ingenting var fel. Tidigare undantogs de
# en och en med grep — en lista som växte varje gång paketet fick en ny
# informationsrad. [warning] och [error] passerar fortfarande rakt igenom.
CLREST=""
[ -n "$CL" ] && CLREST=$(grep -v '^[[:space:]]*$' "$CL" | grep -v '\[Scripting\]\[inform\]' || true)
if [ -n "$CLREST" ]; then
  bad "innehållsfel i $(basename "$CL")"; echo "$CLREST" | head -5 | sed 's/^/     /'
else
  ok "inga innehållsfel"
fi

# Spelar-röktest: en RIKTIG klient (bedrock-protocol) ansluter och verifierar
# det kommandosidan aldrig ser — item_registry, give av egna föremål,
# entitetsströmning, property-synk. Frivilligt steg: kräver testboten.
if [ -f "$SRC/tools/testbot/smoke-test.js" ] && [ -d /opt/purrfect-testbot/node_modules ]; then
  echo
  echo "[5/5] Spelar-röktest (riktig klient)"
  # KÄLLAN ÄR REPOTS KOPIA, körningen sker där beroendena bor. Det fanns två
  # filer: tools/testbot/smoke-test.js i versionshantering och en kopia i
  # /opt/purrfect-testbot som testet faktiskt startade. De glred isär utan att
  # något märkte det — en ändring i repot ändrade ingenting, och repofilen såg
  # ut att vara källan medan den var död kod. Nu kopieras den in före varje
  # körning, så det finns ett ställe att redigera.
  cp "$SRC/tools/testbot/smoke-test.js" /opt/purrfect-testbot/smoke-test.js
  # Tre serveruppstarter i följd på 2 kärnor gör första försöket flaky
  # (RakNet-ping hinner inte besvaras) — ge testet ETT omförsök.
  BOTOUT=$(cd /opt/purrfect-testbot && timeout 120 node smoke-test.js 2>/dev/null | grep -E "^(OK|FAIL)")
  if echo "$BOTOUT" | grep -q "^FAIL"; then
    echo "  (omförsök — första kan vara resurs-flake)"
    sleep 5
    BOTOUT=$(cd /opt/purrfect-testbot && timeout 120 node smoke-test.js 2>/dev/null | grep -E "^(OK|FAIL)")
  fi
  echo "$BOTOUT" | sed 's/^/  /'
  echo "$BOTOUT" | grep -q "^FAIL" && bad "spelar-röktestet föll"
  [ -z "$BOTOUT" ] && bad "spelar-röktestet gav ingen utdata"
fi

# Simulerad spelare (GameTest): tämja+sadla+rida via riktiga interaktioner.
if [ -x "$SRC/tools/purrfect-gametest" ]; then
  echo
  echo "[6/6] Simulerad spelare (GameTest)"
  if "$SRC/tools/purrfect-gametest" > /tmp/purrfect-gt-stage.txt 2>&1; then
    grep -E "MJAU-GT|PASS" /tmp/purrfect-gt-stage.txt | tail -4 | sed 's/^/  /'
    ok "simulerad spelare: tämja, sadla, rida"
  else
    tail -6 /tmp/purrfect-gt-stage.txt | sed 's/^/  /'
    bad "gametest föll"
  fi
fi

echo
if [ $FAIL -eq 0 ]; then echo "=== ALLT GRÖNT — v$VER redo att skickas ==="
else echo "=== FEL HITTADE — fixa innan du skickar (logg: $LOG) ==="; fi
exit $FAIL
