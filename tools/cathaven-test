#!/bin/bash
# Testar Cat Haven-världarna (Kattgården): bygger båda varianterna från källan,
# kontrollerar det paketerade artefaktet statiskt och bootar det i servern.
# Bygget i sig verifierar redan under konstruktion (testforblock/testfor via
# stdin) — steg 3 finns för att fånga fel i PAKETERINGEN: trasig level.dat,
# fel paket-UUID:n i world_*_packs.json, strukturer som läckt in i skeppade BP.
set -u
# EN Bedrock-server åt gången — vänta på låset i stället för att krocka på portarna.
# Ärftligt: barnprocesserna (build_world.py ×2) tar inte låset igen — självdeadlock annars.
if [ "${BDS_LOCK_HELD:-}" != "1" ]; then
  exec 9>/tmp/bds.lock; flock -w 1200 9 || { echo "kunde inte ta serverlåset"; exit 1; }
  export BDS_LOCK_HELD=1
fi
SRC=/opt/purrfect-companions
SRV=/opt/bds/server
OUT=/tmp/cathaven-test-out
FAIL=0
ok(){ echo "  ✅ $1"; }
bad(){ echo "  ❌ $1"; FAIL=1; }

echo "=== Cat Haven-test $(date '+%F %H:%M') ==="

echo
echo "[1/3] Bygger båda varianterna (2 serverbyggen, ~3 min)"
rm -rf "$OUT"
for V in public private; do
  if python3 "$SRC/build_world.py" "$V" "$OUT" > /tmp/cathaven-test-$V.txt 2>&1; then
    ok "variant $V: byggd + byggverifierad (mark, kista, damm, fyrljus, 4 katter)"
  else
    sed 's/^/    /' /tmp/cathaven-test-$V.txt | tail -6
    bad "variant $V föll i bygget"
  fi
done

echo
echo "[2/3] Statisk kontroll av paketen"
STAT=$(python3 - "$OUT" <<'PY'
import glob, json, os, sys, zipfile
sys.path.insert(0, "/opt/purrfect-companions/tools/gametest")
import nbt
bad = []
worlds = sorted(glob.glob(f"{sys.argv[1]}/*.mcworld"))
if len(worlds) != 2: bad.append(f"väntade 2 världar, hittade {len(worlds)}")
for w in worlds:
    z = zipfile.ZipFile(w)
    names = z.namelist()
    fam = "familj" in w
    # level.dat: rätt namn, survival, fusk av
    ver_len = z.read("level.dat")[:8]
    import struct as _s, io, tempfile
    with tempfile.NamedTemporaryFile(suffix=".dat", delete=False) as tf:
        tf.write(z.read("level.dat")); p = tf.name
    _, root = nbt.read_level_dat(p); os.unlink(p)
    d = root.v
    want = "Kattgården" if fam else "Cat Haven"
    # världsnamnet bär versionen ("Kattgården 2.7.2") — två identiska namn i
    # världslistan fick speltestet att öppna FEL kopia
    if not d["LevelName"].v.startswith(want) or d["LevelName"].v == want:
        bad.append(f"{os.path.basename(w)}: LevelName '{d['LevelName'].v}' ska vara '{want} <version>'")
    if d["GameType"].v != 0: bad.append(f"{os.path.basename(w)}: GameType != survival")
    if d["commandsEnabled"].v != 0: bad.append(f"{os.path.basename(w)}: fusk är PÅ i skeppad värld")
    # inbäddade paket: UUID/version i world_*_packs.json måste matcha manifesten
    for kind, pack in (("behavior", "PurrfectCompanions_BP"), ("resource", "PurrfectCompanions_RP")):
        ref = json.loads(z.read(f"world_{kind}_packs.json"))[0]
        man = json.loads(z.read(f"{kind}_packs/{pack}/manifest.json"))["header"]
        if ref["pack_id"] != man["uuid"]: bad.append(f"{os.path.basename(w)}: {kind}-UUID matchar inte inbäddat paket")
        if ref["version"] != man["version"]: bad.append(f"{os.path.basename(w)}: {kind}-version matchar inte")
    # VERSIONS-INTEGRITET: världens inbäddade paket måste vara IDENTISKA med
    # add-onet av samma version (v2.3.1-läxan: samma UUID+version med olika
    # innehåll => "packs failed to load" på Xbox). Jämför mot loggbokens
    # content-sha för versionen+varianten — finns en rad och innehållet
    # skiljer sig har källan ändrats efter paketering: bumpa versionen.
    import hashlib, subprocess
    _ver = ".".join(map(str, json.loads(z.read("behavior_packs/PurrfectCompanions_BP/manifest.json"))["header"]["version"]))
    _variant = "private" if fam else "public"
    _stage = f"/tmp/cathaven-ledgercheck-{_variant}"
    subprocess.run(["python3", "/opt/purrfect-companions/make_variant.py", _variant, _stage],
                   check=True, capture_output=True)
    _h = hashlib.sha256()
    import os as _os
    _files = []
    for _root, _, _fns in _os.walk(_stage):
        for _fn in _fns: _files.append(_os.path.join(_root, _fn))
    for _p in sorted(_files, key=lambda p: _os.path.relpath(p, _stage)):
        _h.update(open(_p, "rb").read())
    for _line in open("/opt/purrfect-companions/.shipped.tsv"):
        _c = _line.rstrip("\n").split("\t")
        if _c[0] == _ver and _c[1] == _variant:
            # jämför paketstadiets innehåll nu mot när versionen skeppades
            _cur = subprocess.run(["bash", "-c",
                f"cd {_stage} && find . -type f | LC_ALL=C sort | xargs sha256sum | sha256sum | cut -d' ' -f1"],
                capture_output=True, text=True).stdout.strip()
            if _cur != _c[2]:
                bad.append(f"{os.path.basename(w)}: v{_ver} ({_variant}) är redan skeppad med ANNAT "
                           f"innehåll — samma UUID+version med olika innehåll vägrar ladda på Xbox. Bumpa!")
            break
    # byggstrukturerna får inte läcka med i det skeppade paketet
    if any("/structures/" in n for n in names):
        bad.append(f"{os.path.basename(w)}: byggstrukturer har läckt in i skeppat BP")
    # världslistan visar world_icon.jpeg — utan den blir listposten anonym
    if "world_icon.jpeg" not in names:
        bad.append(f"{os.path.basename(w)}: world_icon.jpeg saknas")
    elif z.read("world_icon.jpeg")[:2] != b"\xff\xd8":
        bad.append(f"{os.path.basename(w)}: world_icon.jpeg är inte en JPEG")
    # familjenamn får aldrig finnas i den publika världen
    if not fam:
        blob = b" ".join(z.read(n) for n in names if n.endswith((".json", ".lang")))
        for privat in (b"vinda", b"vilma", b"lillen", b"maja"):
            if privat in blob.lower(): bad.append(f"{os.path.basename(w)}: privat namn '{privat.decode()}' i publik värld")
# böckerna och skyltarna: parse:a ALLA byggstrukturer och verifiera innehållet.
# Skyltrader över ~15 tecken KLIPPS i spelet (Xbox-rapport: "texten är klippt").
for variant, title in (("public", "The Caretaker's Handbook"), ("private", "Föreståndarens handbok")):
    books = signs = 0
    for p in glob.glob(f"/tmp/cathaven-buildbp-{variant}/structures/haven/*.mcstructure"):
        data = open(p, "rb").read()
        root, _ = nbt._read(data, 3 + len("".encode()), nbt.TAG_COMPOUND)
        pos = root.v["structure"].v["palette"].v["default"].v["block_position_data"].v
        for entry in pos.values():
            be = entry.v["block_entity_data"].v
            if be["id"].v == "Chest":
                for it in be["Items"].v[1]:
                    if it.v["Name"].v == "minecraft:written_book":
                        tag = it.v["tag"].v
                        if tag["title"].v == title and len(tag["pages"].v[1]) >= 5: books += 1
            if be["id"].v == "Sign":
                txt = be["FrontText"].v["Text"].v
                if txt: signs += 1
                for line in txt.split("\n"):
                    if len(line) > 15:
                        bad.append(f"{variant}: skyltrad '{line}' är {len(line)} tecken — klipps i spelet (max ~15)")
    if books != 1: bad.append(f"{variant}: välkomstboken saknas/fel titel i kistan")
    if signs < 8: bad.append(f"{variant}: bara {signs}/8 skyltar med text (namn+välkommen+start+kista+katt)")
print("\n".join(bad))
PY
)
if [ -n "$STAT" ]; then echo "$STAT" | while read -r l; do bad "$l"; done; FAIL=1
else ok "level.dat, paket-UUID:n, inga läckta strukturer, inga privata namn publikt, bok + 4 skyltar i båda varianterna"; fi

echo
echo "[3/3] Bootar den paketerade publika världen (~1 min)"
W=$(ls "$OUT"/purrfect-cat-haven-*.mcworld 2>/dev/null | head -1)
if [ -z "$W" ]; then bad "ingen publik .mcworld att boota"; else
  SMOKE="$SRV/worlds/CatHavenSmoke"
  rm -rf "$SMOKE"; mkdir -p "$SMOKE"
  ( cd "$SMOKE" && unzip -qq "$W" )
  # skeppad värld har fusk AV — slå på i testkopian så konsolen kan verifiera
  python3 - "$SMOKE" <<'PY'
import sys
sys.path.insert(0, "/opt/purrfect-companions/tools/gametest")
import nbt
v, root = nbt.read_level_dat(f"{sys.argv[1]}/level.dat")
root.v["commandsEnabled"] = nbt.Val(nbt.TAG_BYTE, 1)
nbt.write_level_dat(f"{sys.argv[1]}/level.dat", v, root)
PY
  pkill -9 -x bedrock_server 2>/dev/null; sleep 2
  PROPS="$SRV/server.properties"; cp "$PROPS" /tmp/cathaven-props.bak
  sed -i "s/^level-name=.*/level-name=CatHavenSmoke/" "$PROPS"
  SLOG=/tmp/cathaven-smoke.log
  { sleep 28
    echo "tickingarea add -20 -70 -10 20 -40 60 rök"; sleep 4
    echo "testforblock -4 -59 9 chest"; sleep 1
    echo "testforblock 12 -60 7 mjau:fiskdamm"; sleep 1
    echo "testforblock 17 -61 7 water"; sleep 1
    echo "testforblock 2 -59 8 mjau:kattlucka"; sleep 1
    echo "testforblock -2 -42 56 chest"; sleep 1
    echo "testforblock 1 -50 56 ladder"; sleep 1
    echo "testforblock -1 -59 8 wooden_door"; sleep 1
    echo "testforblock -1 -58 8 wooden_door"; sleep 1
    echo "testfor @e[type=mjau:misty,x=-9,y=-60,z=33,r=80]"; sleep 1
    # kistprovet: slå sönder startkistan (i SMOKE-kopian, inte skeppade filen)
    # — bara riktiga, accepterade föremål trillar ut som item-entiteter.
    # Vägrar Minecraft NBT:n (fel format, okänt id) blir golvet tomt.
    echo "setblock -4 -59 9 air destroy"; sleep 2
    echo "testfor @e[type=item,x=-4,y=-59,z=9,r=8]"; sleep 1
    echo "tickingarea remove rök"; sleep 1
    echo "stop"; sleep 8
  } | ( cd "$SRV" && LD_LIBRARY_PATH=. ./bedrock_server ) > "$SLOG" 2>&1
  pkill -9 -x bedrock_server 2>/dev/null
  cp /tmp/cathaven-props.bak "$PROPS"
  grep -q "Pack Stack.*Purrfect Companions" "$SLOG" && ok "paketen laddades ur den skeppade världen" || bad "paketen laddades INTE ur världen"
  FB=$(grep -c 'found the block' "$SLOG")
  [ "$FB" -ge 8 ] && ok "alla $FB/8 nyckelblock finns (kista, damm, vatten, kattlucka, fyrkista, stege, dörrhalvorna)" || bad "bara $FB/8 nyckelblock i den paketerade världen"
  grep -q "Found Misty" "$SLOG" && ok "Misty överlevde paketeringen (namngiven, persistent)" || bad "Misty saknas i den paketerade världen"
  DROP=$(awk '/Block placed/{m=1; next} m && /Found /{f=1} END{print f+0}' "$SLOG")
  if [ "$DROP" -ge 1 ]; then
    ok "kistföremålen är riktiga — trillade ut som item-entiteter vid kistprovet"
  else
    bad "kistprovet: inga föremål föll ur kistan — NBT-innehållet avvisades?"
  fi
  ERRS=$(grep -iE "error|failed" "$SLOG" | grep -cv "errorMessage=(null)")
  [ "$ERRS" -eq 0 ] && ok "inga fel i serverloggen" || bad "$ERRS fel-rader i serverloggen ($SLOG)"
  rm -rf "$SMOKE"
fi

echo
echo "[4/4] Genomspelning: simulerad spelare spelar alla uppdrag (~4 min)"
if "$SRC/tools/cathaven-playthrough" 2>&1 | sed 's/^/  /' | tail -12 && [ ${PIPESTATUS[0]} -eq 0 ]; then
  ok "alla kapitel avklarade"
else
  bad "genomspelningen föll"
fi

echo
if [ $FAIL -eq 0 ]; then echo "=== CAT HAVEN GRÖNT ==="; else echo "=== FEL HITTADE ==="; fi
exit $FAIL
