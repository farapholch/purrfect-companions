#!/bin/bash
# Sista milen i testkedjan: en SIMULERAD SPELARE (Mojangs GameTest-ramverk) gör
# det ingen annan del av sviten kan — går spelarens väg genom interaktionerna.
# Tämjer med torsk i handen (riktig tameable → ägare), sadlar genom
# is_owner+has_equipment-filtren, sitter upp. Event-testerna hoppar över
# filtren; nätverksboten stoppades av serverns klienthandslag (tools/testbot/).
#
# Kör inne i servern via beta-API:er — kräver experimentet 'gametest' i
# testvärldens level.dat (aktiverat 2026-08-08; ombyggd värld => kör
# tools/gametest/build_gametest_pack.py-flödet igen, se nbt.py).
# GameTest-paketet är TESTENDA och skickas aldrig till spelare.
#
# Exit 0 = PASS. Skapad 2026-08-08.
set -u
FURNITURE_CASE=mobler
if [ "${1:-}" = "--water" ]; then FURNITURE_CASE=water; set -- --furniture; fi
if [ "${1:-}" = "--scratch" ]; then FURNITURE_CASE=scratch; set -- --furniture; fi
if [ "${1:-}" = "--spa-tv" ]; then FURNITURE_CASE=spa_tv; set -- --furniture; fi
# EN Bedrock-server åt gången — vänta på låset i stället för att krocka på portarna.
# Ärftligt: hoppar över om föräldern (purrfect-test) redan håller det.
if [ "${BDS_LOCK_HELD:-}" != "1" ]; then
  exec 9>/tmp/bds.lock; flock -w 1200 9 || { echo "kunde inte ta serverlåset"; exit 1; }
  export BDS_LOCK_HELD=1
fi
SRC=/opt/purrfect-companions
SRV=/opt/bds/server
W="$SRV/worlds/Kattest"
# SERVERN MÅSTE PEKA PÅ KATTVÄRLDEN. En avbruten körning i hund- eller
# grispaketet lämnar level-name kvar på sin egen värld, och då kör gametest
# mot fel paket: "Could not find test with name 'mjau:...'" för alla nio,
# utan ett ord om varför. Kostade en halvtimmes felsökning 2026-09-06.
sed -i "s/^level-name=.*/level-name=Kattest/" "$SRV/server.properties"
LOG=/tmp/purrfect-gametest.log

# Modulversionerna är per BDS-version; fel version => servern LISTAR de rätta
# i loggen. Uppdatera här när BDS bytts.
SERVER_MOD="2.10.0-beta"
GAMETEST_MOD="1.0.0-beta"

echo "[gametest] bygger och installerar testpaketet"
python3 "$SRC/tools/gametest/build_gametest_pack.py" /tmp/purrfect-gametest-pack "$SERVER_MOD" "$GAMETEST_MOD" >/dev/null
rm -rf "$W/behavior_packs/PurrfectGameTest"
cp -r /tmp/purrfect-gametest-pack "$W/behavior_packs/PurrfectGameTest"
# HUVUDPAKETET: kopieras varje körning, precis som hamnpacken. Utan den här
# raden testar gametestet den kopia purrfect-test råkade lämna i världen —
# alltså gammal kod. Det kostade tre körningar och tre falska FAIL innan det
# upptäcktes: överlämningen som testades fanns inte i världens paket.
rm -rf "$W/behavior_packs/PurrfectCompanions_BP" "$W/resource_packs/PurrfectCompanions_RP"
cp -r "$SRC/PurrfectCompanions_BP" "$W/behavior_packs/PurrfectCompanions_BP"
mkdir -p "$W/resource_packs"
cp -r "$SRC/PurrfectCompanions_RP" "$W/resource_packs/PurrfectCompanions_RP"
# HAMNPACKEN: skeppet flyttade ut ur kattpaketet, så utan den här raden finns
# mjau:spjutjaktare inte i testvärlden och skepp-testet faller på "could not
# spawn entity" — inte för att skeppet är trasigt, utan för att det saknas.
rm -rf "$W/behavior_packs/PurrfectHarbour_BP" "$W/resource_packs/PurrfectHarbour_RP"
cp -r "$SRC/PurrfectHarbour_BP" "$W/behavior_packs/PurrfectHarbour_BP"
mkdir -p "$W/resource_packs"
cp -r "$SRC/PurrfectHarbour_RP" "$W/resource_packs/PurrfectHarbour_RP"
# purrfect-test skriver om world_behavior_packs.json med BARA huvudpaketet —
# registrera oss igen varje körning.
python3 - "$W" <<'PY'
import json, sys
W = sys.argv[1]
# BYGG LISTAN UR MANIFESTEN, lita inte på det som råkar stå i filen. Den
# innehöll UUID:t för den PUBLIKA varianten (byggd vid CurseForge-släppet)
# medan mappen innehöll källpaketet — resultatet var att huvudpaketet inte
# laddades alls i testvärlden. Testerna såg ut att köra, men mätte ingenting
# av vår kod: noll skriptrader i loggen och en dräkt som "inte gav krafter".
import glob as _g
wb = []
for _m in sorted(_g.glob(f"{W}/behavior_packs/*/manifest.json")):
    _h = json.load(open(_m))["header"]
    wb.append({"pack_id": _h["uuid"], "version": _h["version"]})
gt = {"pack_id": "7c1e9f10-31a2-4a3b-9c58-b5c9d2f4a601", "version": [1, 0, 0]}
if gt not in wb: wb.append(gt)
# hamnpacken måste också stå i listan, annars ligger den bara på disk
hb = json.load(open("/opt/purrfect-companions/PurrfectHarbour_BP/manifest.json"))["header"]
hamn = {"pack_id": hb["uuid"], "version": hb["version"]}
wb = [e for e in wb if e.get("pack_id") != hb["uuid"]] + [hamn]
json.dump(wb, open(f"{W}/world_behavior_packs.json", "w"))
hr = json.load(open("/opt/purrfect-companions/PurrfectHarbour_RP/manifest.json"))["header"]
import os
wrp = f"{W}/world_resource_packs.json"
wr = json.load(open(wrp)) if os.path.exists(wrp) else []
wr = [e for e in wr if e.get("pack_id") != hr["uuid"]] + [{"pack_id": hr["uuid"], "version": hr["version"]}]
json.dump(wr, open(wrp, "w"))
PY

pkill -x bedrock_server 2>/dev/null; sleep 1
rm -f "$LOG"
cd "$SRV"
{ until grep -q "Server started" "$LOG" 2>/dev/null; do sleep 2; done
  # GameTest läcker tickingareas i den beständiga testvärlden — taket är ~10
  # per värld, och när kvoten är full nekas "Failed to spawn test structure".
  echo "tickingarea remove_all"; sleep 2
  # REN VÄRLD FÖRE PROVEN. Kattest är beständig och samlar på sig katter,
  # föremål och skepp från varje körning. En gammal katt som råkar stå
  # närmare nystanet vinner kapplöpningen, och provet faller fast mekaniken
  # fungerar — det kostade tre släpp innan orsaken var klar. Proven spawnar
  # sina egna djur, så det finns inget att spara.
  echo "kill @e[family=mjaukatt]"; sleep 2
  echo "kill @e[type=minecraft:item]"; sleep 2
  if [ "${1:-}" != "--furniture" ] && [ "${1:-}" != "--window" ]; then
  echo "gametest run mjau:interakt"
  echo "gametest run mjau:vagn"
  echo "gametest run mjau:ritual"
  echo "gametest run mjau:sate"
  echo "gametest run mjau:skepp"
  echo "gametest run mjau:totem"
  echo "gametest run mjau:stortdyk"
  # vänta in de sju som tål sällskap
  for i in $(seq 1 80); do
    N=$(grep -cE "MJAU-GT\] (PASS|FAIL)" "$LOG" 2>/dev/null)
    grep -q "failed to create context" "$LOG" && break
    [ "${N:-0}" -ge 7 ] && break
    sleep 3
  done
  # SHOW OCH GARN KÖRS ENSAMMA. Alla prov delar en arena, och de här två hänger
  # på VAR djuren står: en granntests katt hann fram till nystanet först, och en
  # katt som strövade förbi podiet störde bedömningen. Tre släpp i rad föll på
  # det, med olika avstånd varje gång och ingenting fel i paketet.
  echo "kill @e[family=mjaukatt]"; sleep 2
  echo "kill @e[type=minecraft:item]"; sleep 2
  echo "gametest run mjau:show"
  for i in $(seq 1 40); do
    N=$(grep -cE "MJAU-GT\] (PASS|FAIL)" "$LOG" 2>/dev/null)
    [ "${N:-0}" -ge 8 ] && break
    sleep 3
  done
  echo "kill @e[family=mjaukatt]"; sleep 2
  echo "kill @e[type=minecraft:item]"; sleep 2
  echo "gametest run mjau:garn"
  for i in $(seq 1 60); do
    N=$(grep -cE "MJAU-GT\] (PASS|FAIL)" "$LOG" 2>/dev/null)
    [ "${N:-0}" -ge 9 ] && break
    sleep 3
  done
  fi
  echo "kill @e[family=mjaukatt]"; sleep 2
  echo "kill @e[type=minecraft:item]"; sleep 2
  if [ "${1:-}" != "--window" ]; then
  echo "gametest run mjau:$FURNITURE_CASE"
  for i in $(seq 1 125); do
    grep -qE "MJAU-GT\] (PASS|FAIL) mobler:" "$LOG" && break
    sleep 3
  done
  fi
  if [ "${1:-}" != "--furniture" ]; then
  echo "kill @e[family=mjaukatt]"; sleep 2
  echo "gametest run mjau:fonster"
  for i in $(seq 1 105); do
    grep -qE "MJAU-GT\] (PASS|FAIL) fonster:" "$LOG" && break
    sleep 3
  done
  fi
  echo "stop"; sleep 5; } | LD_LIBRARY_PATH=. ./bedrock_server > "$LOG" 2>&1
pkill -9 -x bedrock_server 2>/dev/null

grep -oE "\[MJAU-GT\].*" "$LOG" | sed 's/^/  /'
PASSN=$(grep -c "MJAU-GT\] PASS" "$LOG")
if [ "${1:-}" = "--furniture" ]; then
  grep -q "MJAU-GT\] PASS mobler:" "$LOG" && ! grep -q "MJAU-GT\] FAIL" "$LOG"
  exit $?
fi
if [ "${1:-}" = "--window" ]; then
  grep -q "MJAU-GT\] PASS fonster:" "$LOG" && ! grep -q "MJAU-GT\] FAIL" "$LOG"
  exit $?
fi
# STÖRTDYKAREN: fallmätningen kvitterar i loggen (kan inte ses av GameTest-
# provet självt — ryttaren är osynlig för stabila API:n). Utan kvittot
# landade katten, men mekaniken bakom utmärkelsen körde aldrig.
if ! grep -q "\[mjau\] utstallning: .* fick [0-9]* poang" "$LOG"; then
  echo "[gametest] ❌ podiet gav ingen poäng när en spelare tryckte på det"; exit 1
fi
if ! grep -q "\[mjau\] stortdyk: [0-9]* block" "$LOG"; then
  echo "[gametest] ❌ störtdyket kvitterades aldrig av main.js (fallmätningen)"; exit 1
fi
if [ "$PASSN" -ge 11 ] && ! grep -q "MJAU-GT\] FAIL" "$LOG"; then
  echo "[gametest] ✅ PASS ($PASSN/11) — rida+styra, vagnen, ritualen, sateshojden, spjutjaktaren, totemet, stortdykaren, podiet, garnet och fönsterbädden"
  exit 0
fi
echo "[gametest] ❌ FAIL (logg: $LOG)"
grep -iE "error|failed" "$LOG" | head -5 | sed 's/^/  /'
exit 1
