cd "$SRV" || exit 1
{
  sleep 28
  echo "tickingarea add 0 0 0 48 48 48 mjau"; sleep 3
  echo "summon minecraft:pig 10 20 10"; sleep 2
  for c in $CATS; do echo "summon mjau:$c 10 20 10"; sleep 2; done
  for ev in $EVENTS; do
