#!/bin/bash
# Testar Stjärnhamnen: bygger båda varianterna från källan, kontrollerar det
# paketerade artefaktet statiskt och bootar det i servern.
#
# Motsvarigheten till cathaven-test. Byggets egna testforblock bevisar att
# blocken FINNS — det här steget fångar sådant bygget inte kan se: trasig
# level.dat, fel paket-UUID:n, strukturer som läckt in i skeppade BP,
# familjenamn i den publika filen, klippta skyltrader, och framför allt att
# man faktiskt kan TA SIG FRAM (utkiken var oåtkomlig i tre versioner utan
# att något test märkte det).
set -u
# EN Bedrock-server åt gången — vänta på låset i stället för att krocka.
# Ärftligt: barnprocesserna (build_spaceworld.py ×2) tar inte låset igen.
if [ "${BDS_LOCK_HELD:-}" != "1" ]; then
  exec 9>/tmp/bds.lock; flock -w 1200 9 || { echo "kunde inte ta serverlåset"; exit 1; }
  export BDS_LOCK_HELD=1
fi
SRC=/opt/purrfect-companions
SRV=/opt/bds/server
OUT=/tmp/hamn-test-out
FAIL=0
ok(){ echo "  ✅ $1"; }
bad(){ echo "  ❌ $1"; FAIL=1; }

echo "=== Stjärnhamnen-test $(date '+%F %H:%M') ==="

echo
echo "[1/3] Bygger båda varianterna (2 serverbyggen, ~3 min)"
rm -rf "$OUT"
for V in public private; do
  if python3 "$SRC/build_spaceworld.py" "$V" "$OUT" > /tmp/hamn-test-$V.txt 2>&1; then
    ok "variant $V: byggd + byggverifierad (kupol, korridor, hangar, utkik, 4 katter)"
  else
    sed 's/^/    /' /tmp/hamn-test-$V.txt | tail -6
    bad "variant $V föll i bygget"
  fi
done

echo
echo "[2/3] Statisk kontroll av paketen"
STAT=$(python3 - "$OUT" <<'PY'
import glob, json, os, sys, tempfile, zipfile
sys.path.insert(0, "/opt/purrfect-companions/tools/gametest")
import nbt
bad = []
varldar = sorted(glob.glob(f"{sys.argv[1]}/*.mcworld"))
if len(varldar) != 2: bad.append(f"väntade 2 världar, hittade {len(varldar)}")
for w in varldar:
    z = zipfile.ZipFile(w); namn = z.namelist(); fam = "familj" in w
    with tempfile.NamedTemporaryFile(suffix=".dat", delete=False) as tf:
        tf.write(z.read("level.dat")); p = tf.name
    _, root = nbt.read_level_dat(p); os.unlink(p)
    d = root.v
    vill = "Stjärnhamnen" if fam else "Star Harbour"
    # världsnamnet bär versionen — två identiska namn i listan fick
    # speltestet att öppna FEL kopia (samma läxa som Cat Haven)
    if not d["LevelName"].v.startswith(vill) or d["LevelName"].v == vill:
        bad.append(f"{os.path.basename(w)}: LevelName '{d['LevelName'].v}' ska vara '{vill} <version>'")
    if d["GameType"].v != 0: bad.append(f"{os.path.basename(w)}: GameType != survival")
    if d["commandsEnabled"].v != 0: bad.append(f"{os.path.basename(w)}: fusk är PÅ i skeppad värld")
    # inbäddade paket: UUID/version måste matcha manifesten
    # TVÅ paket per sort: kattpaketet + hamnpacken med skeppet. Varje post i
    # world_*_packs.json måste peka på ett paket som FINNS i filen, annars
    # vägrar världen ladda.
    for sort, packar in (("behavior", ["PurrfectCompanions_BP", "PurrfectHarbour_BP"]),
                         ("resource", ["PurrfectCompanions_RP", "PurrfectHarbour_RP"])):
        refs = json.loads(z.read(f"world_{sort}_packs.json"))
        if len(refs) != 2:
            bad.append(f"{os.path.basename(w)}: {sort}-listan har {len(refs)} paket, väntade 2")
        manifest = {}
        for pack in packar:
            h = json.loads(z.read(f"{sort}_packs/{pack}/manifest.json"))["header"]
            manifest[h["uuid"]] = h["version"]
        for ref in refs:
            if ref["pack_id"] not in manifest:
                bad.append(f"{os.path.basename(w)}: {sort}-UUID {ref['pack_id'][:8]} saknar paket i filen")
            elif ref["version"] != manifest[ref["pack_id"]]:
                bad.append(f"{os.path.basename(w)}: {sort}-version matchar inte för {ref['pack_id'][:8]}")
    if any("/structures/" in n for n in namn):
        bad.append(f"{os.path.basename(w)}: byggstrukturer har läckt in i skeppat BP")
    if "world_icon.jpeg" not in namn:
        bad.append(f"{os.path.basename(w)}: world_icon.jpeg saknas")
    elif z.read("world_icon.jpeg")[:2] != b"\xff\xd8":
        bad.append(f"{os.path.basename(w)}: world_icon.jpeg är inte en JPEG")
    # EGEN ikon: Stjärnhamnen ärvde Cat Havens och båda såg likadana ut
    elif os.path.exists("/tmp/cathaven-world-icon.jpeg") and \
         z.read("world_icon.jpeg") == open("/tmp/cathaven-world-icon.jpeg", "rb").read():
        bad.append(f"{os.path.basename(w)}: använder Cat Havens ikon, inte sin egen")
    # familjenamn får ALDRIG finnas i den publika världen
    if not fam:
        blob = b" ".join(z.read(n) for n in namn if n.endswith((".json", ".lang")))
        for privat in (b"vinda", b"vilma", b"lillen", b"maja"):
            if privat in blob.lower():
                bad.append(f"{os.path.basename(w)}: privat namn '{privat.decode()}' i publik värld")
# loggboken och skyltarna: parse:a byggstrukturerna och kontrollera innehållet.
# Skyltrader över ~15 tecken KLIPPS i spelet.
for variant, titel in (("public", "The Harbourmaster's Log"), ("private", "Hamnmästarens loggbok")):
    bocker = skyltar = 0
    for p in glob.glob(f"/tmp/hamn-buildbp-{variant}/structures/hamn/*.mcstructure"):
        data = open(p, "rb").read()
        root, _ = nbt._read(data, 3 + len("".encode()), nbt.TAG_COMPOUND)
        pos = root.v["structure"].v["palette"].v["default"].v["block_position_data"].v
        for entry in pos.values():
            be = entry.v["block_entity_data"].v
            if be["id"].v == "Chest":
                for it in be["Items"].v[1]:
                    if it.v["Name"].v == "minecraft:written_book":
                        tag = it.v["tag"].v
                        if tag["title"].v == titel and len(tag["pages"].v[1]) >= 5: bocker += 1
            if be["id"].v == "Sign":
                txt = be["FrontText"].v["Text"].v
                if txt: skyltar += 1
                for rad in txt.split("\n"):
                    if len(rad) > 15:
                        bad.append(f"{variant}: skyltrad '{rad}' är {len(rad)} tecken — klipps i spelet")
    if bocker != 1: bad.append(f"{variant}: loggboken saknas/fel titel i startkistan")
    if skyltar < 8: bad.append(f"{variant}: bara {skyltar}/8 skyltar med text (4 platsskyltar + 4 kattnamn)")
print("\n".join(bad))
PY
)
if [ -n "$STAT" ]; then echo "$STAT" | while read -r l; do bad "$l"; done; FAIL=1
else ok "level.dat, paket-UUID:n, egen ikon, inga läckta strukturer, inga privata namn publikt, loggbok + skyltar"; fi

echo
echo "[3/3] Bootar den paketerade publika världen (~1 min)"
W=$(ls "$OUT"/star-harbour-*.mcworld 2>/dev/null | head -1)
if [ -z "$W" ]; then bad "ingen publik .mcworld att boota"; else
  SMOKE="$SRV/worlds/StarHarbourSmoke"
  rm -rf "$SMOKE"; mkdir -p "$SMOKE"
  ( cd "$SMOKE" && unzip -qq "$W" )
  # skeppad värld har fusk AV — slå på i testkopian så konsolen kan verifiera
  python3 - "$SMOKE" <<'PY'
import sys
sys.path.insert(0, "/opt/purrfect-companions/tools/gametest")
import nbt
v, root = nbt.read_level_dat(f"{sys.argv[1]}/level.dat")
root.v["commandsEnabled"] = nbt.Val(nbt.TAG_BYTE, 1)
nbt.write_level_dat(f"{sys.argv[1]}/level.dat", v, root)
PY
  pkill -9 -x bedrock_server 2>/dev/null; sleep 2
  PROPS="$SRV/server.properties"; cp "$PROPS" /tmp/hamn-props.bak
  sed -i "s/^level-name=.*/level-name=StarHarbourSmoke/" "$PROPS"
  SLOG=/tmp/hamn-smoke.log
  { sleep 28
    echo "tickingarea add -20 -70 -20 78 -20 40 station"; sleep 4
    # KUPOLEN
    echo "testforblock 0 -52 0 glass"; sleep 1            # kupoltaket
    echo "testforblock -3 -60 3 chest"; sleep 1           # startkistan
    echo "testforblock -8 -60 -8 mjau:kattbadd"; sleep 1  # kattbäddarna
    echo "testforblock 0 -61 0 sea_lantern"; sleep 1      # navet
    # KORRIDOREN
    echo "testforblock 21 -57 0 sea_lantern"; sleep 1     # takbelysningen
    echo "testforblock 14 -60 -2 chest"; sleep 1          # bladfack: blått
    echo "testforblock 32 -60 2 chest"; sleep 1           # bladfack: grönt
    # HANGAREN
    echo "testforblock 47 -59 0 chest"; sleep 1           # skyttelns lastrum
    echo "testforblock 45 -57 0 glass"; sleep 1           # cockpitfönstret
    # HANGARPORTEN + LANDNINGSPLATTAN: utan dem sitter ett flygbart skepp
    # fast i en sluten låda
    echo "testforblock 56 -57 0 air"; sleep 1             # porten är öppen
    echo "testforblock 65 -61 0 light_gray_concrete"; sleep 1
    echo "testforblock 74 -60 0 iron_block"; sleep 1      # kanten mot tomrummet
    echo "testforblock 70 -60 0 sea_lantern"; sleep 1     # inflygningsljus
    echo "testforblock 36 -60 -12 chest"; sleep 1         # bladfack: rött
    # UTKIKEN — vägen dit, inte bara att däcket finns
    echo "testforblock 0 -52 17 ladder"; sleep 1          # servicestegen i schaktet
    echo "testforblock 0 -45 17 air"; sleep 1             # luckan i däcksgolvet
    echo "testforblock 0 -45 16 quartz_block"; sleep 1    # däcket
    echo "testforblock 4 -44 19 chest"; sleep 1           # bladfack: lila
    # GÅNGVÄGEN. Det HÄR är felet testet missade: alla nyckelblock fanns, men
    # kupolen, korridoren, hangaren och tornet var fyra slutna lådor ("fill
    # ... hollow" lägger gavlarna med). Två katter och båda jaktplanen låg
    # bakom järnväggar. Speltest på Xbox: "det gick inte att nå fram till
    # katterna", "jag såg inga jaktplan alls".
    #
    # Vi provar hela promenaden ruta för ruta: två blocks fri höjd (fötter
    # -60, huvud -59) längs varje sträcka. En vägg var som helst på vägen
    # faller ut som ett saknat luftblock.
    for X in 8 10 12 14 16 20 24 28 30 32 34 36; do   # kupol -> in i hangaren
      echo "testforblock $X -60 0 air"; echo "testforblock $X -59 0 air"; sleep 1
    done
    for Z in 2 4 6 8; do                              # norrut förbi skytteln
      echo "testforblock 36 -60 $Z air"; echo "testforblock 36 -59 $Z air"; sleep 1
    done
    for X in 38 40 42 44 46; do                       # sista biten fram till Mocha
      echo "testforblock $X -60 8 air"; echo "testforblock $X -59 8 air"; sleep 1
    done
    for Z in 8 10 12 13 14 15 16; do                  # kupol -> tornfot
      echo "testforblock 0 -60 $Z air"; echo "testforblock 0 -59 $Z air"; sleep 1
    done
    # VÄGVISARNA vid de tre dörrarna — den röda tråden
    echo "testforblock 11 -60 3 standing_sign"; sleep 1
    echo "testforblock 32 -60 -2 standing_sign"; sleep 1
    echo "testforblock 2 -60 11 standing_sign"; sleep 1
    # MÅNYTAN: generatorns egna lager, inte gräs och inte tomrum. Ytan MÅSTE
    # ligga på -61 — en nivå fel och stationens golv hade begravts.
    echo "testforblock 20 -61 20 tuff"; sleep 1
    echo "testforblock -20 -61 -20 tuff"; sleep 1
    echo "testforblock 0 -60 25 air"; sleep 1
    echo "testforblock 0 -64 25 bedrock"; sleep 1
    # UTPOSTERNA: egna tickingareas, de ligger långt utanför basens
    echo "tickingarea add 4 -70 -106 36 -30 -74 t1"; sleep 3
    echo "testforblock 20 -60 -90 chest"; sleep 1        # provkistan i kratern
    echo "testforblock 26 -52 -84 sea_lantern"; sleep 1  # ljusmasten
    echo "tickingarea remove t1"; sleep 1
    echo "tickingarea add 94 -70 14 126 -30 46 t2"; sleep 3
    echo "testforblock 110 -55 30 iron_block"; sleep 1   # relämasten
    echo "testforblock 112 -60 32 chest"; sleep 1
    echo "tickingarea remove t2"; sleep 1
    echo "tickingarea add -81 -70 29 -49 -30 61 t3"; sleep 3
    echo "testforblock -65 -60 45 sea_lantern"; sleep 1  # sondens kärna
    echo "testforblock -62 -60 45 chest"; sleep 1
    echo "tickingarea remove t3"; sleep 1
    # KATTERNA + kistprovet
    echo "testfor @e[type=mjau:misty,x=-6,y=-60,z=6,r=40]"; sleep 1
    # SKEPPEN: två flygbara jaktplan, inte kulisser av block
    echo "testfor @e[type=mjau:spjutjaktare,x=39,y=-60,z=0,r=20]"; sleep 1
    echo "setblock -3 -60 3 air destroy"; sleep 2
    echo "testfor @e[type=item,x=-3,y=-60,z=3,r=8]"; sleep 1
    echo "tickingarea remove station"; sleep 1
    echo "stop"; sleep 8
  } | ( cd "$SRV" && LD_LIBRARY_PATH=. ./bedrock_server ) > "$SLOG" 2>&1
  pkill -9 -x bedrock_server 2>/dev/null
  cp /tmp/hamn-props.bak "$PROPS"
  grep -q "Pack Stack.*Purrfect Companions" "$SLOG" && ok "paketen laddades ur den skeppade världen" \
    || bad "paketen laddades INTE ur världen"
  FB=$(grep -c 'found the block' "$SLOG")
  [ "$FB" -ge 87 ] && ok "alla $FB/87 kontroller: nyckelblock, hela gångvägen kupol->korridor->hangar->torn, vägvisarna, månytan och de tre utposterna" \
    || bad "bara $FB/87 kontroller i den paketerade världen — se $SLOG för vilket block som fattas"
  grep -qE "Found (Spear Fighter|Spjutjaktare)" "$SLOG" \
    && ok "de två jaktplanen är flygbara entiteter, inte kulisser av block" \
    || bad "jaktplanen saknas i den paketerade världen"
  grep -q "Found " "$SLOG" && ok "katterna överlevde paketeringen (namngivna, persistenta)" \
    || bad "katterna saknas i den paketerade världen"
  # kistprovet: bara riktiga, accepterade föremål trillar ut som item-entiteter.
  # Vägrar Minecraft NBT:n (fel format, okänt id) blir golvet tomt.
  # Leta efter LOGGBOKENS namn specifikt — den bär den känsligaste NBT:n
  # (titel, författare, sidlista). Trillar den ut är resten med säkerhet ok.
  if grep -q "The Harbourmaster's Log" "$SLOG"; then
    ok "kistföremålen är riktiga — loggboken trillade ut vid kistprovet"
  else
    bad "kistprovet: loggboken föll inte ur kistan — NBT-innehållet avvisades?"
  fi
  grep -cE "ERROR" "$SLOG" | grep -q '^0$' && ok "inga fel i serverloggen" \
    || bad "$(grep -c ERROR "$SLOG") fel-rader i serverloggen ($SLOG)"
fi

# SÖKVÄGSLÄNGD: Mod Mate packar upp världen till en djup Windows-katalog och
# döper målmappen efter FILNAMNET. 2026-08-13 föll exakt en fil av 287 i
# överföringen — animation_controllers/katt.animation_controllers.json, den
# längsta sökvägen i paketet — vid 256 tecken. Kattgården på 254 klarade sig.
# Windows MAX_PATH är 260 men flera API:er ger upp redan runt 255.
PATHCHK=$(python3 - "$OUT" <<'PYPATH'
import glob, os, sys, zipfile
# Xbox-sökvägen ur Mod Mates logg, med användarnamnet som prefix
PREFIX = (r"Q:\Users\UserMgr7\AppData\Local\Packages"
          r"\Microsoft.MinecraftUWPConsole_8wekyb3d8bbwe\LocalState\games"
          r"\com.mojang\minecraftWorlds" + "\\")
GRANS = 250          # marginal mot ~255 där WinRT-skrivningen började falla
varst = []
for w in glob.glob(f"{sys.argv[1]}/*.mcworld"):
    mapp = os.path.basename(w).rsplit(".", 1)[0]
    for n in zipfile.ZipFile(w).namelist():
        full = PREFIX + mapp + "\\" + n.replace("/", "\\")
        varst.append((len(full), os.path.basename(w), n))
varst.sort(reverse=True)
langd, fil, post = varst[0]
if langd > GRANS:
    print(f"FÖR LÅNG SÖKVÄG: {langd} tecken ({fil} -> {post}) — Mod Mate tappar filen runt 255")
else:
    print(f"OK {langd}")
PYPATH
)
case "$PATHCHK" in
  OK*) ok "längsta sökväg ${PATHCHK#OK } tecken — under Mod Mates praktiska gräns" ;;
  *)   bad "$PATHCHK" ;;
esac

# EXTRA: addon vs inbäddade paket måste vara BITIDENTISKA.
# 2026-08-13 skilde de sig åt (en tom katalog följde med i .mcaddon men inte
# i .mcworld) — samma UUID + samma version + olika innehåll är precis det
# felläge som ger "packs failed to load" på Xbox. Ingen kontroll såg det:
# versionskontrollen jämför bara mot loggboken över skeppade versioner.
ADDON=$(ls -t /tmp/purrfect-companions-v*-familj.mcaddon 2>/dev/null | head -1)
if [ -n "$ADDON" ]; then
  AV=$(basename "$ADDON" | sed -E 's/.*-v([0-9.]+)-familj.*/\1/')
  WV=$(ls "$OUT"/stjarnhamnen-v*-familj.mcworld 2>/dev/null | head -1 | sed -E 's/.*-v([0-9.]+)-familj.*/\1/')
  if [ "$AV" != "$WV" ]; then
    ok "hoppar över paketjämförelsen (addon v$AV, värld v$WV — olika versioner, ingen krock möjlig)"
  else
    rm -rf /tmp/hamn-packcmp && mkdir -p /tmp/hamn-packcmp/a /tmp/hamn-packcmp/v
    ( cd /tmp/hamn-packcmp/a && unzip -qq "$ADDON" )
    ( cd /tmp/hamn-packcmp/v && unzip -qq "$(ls "$OUT"/stjarnhamnen-v*-familj.mcworld | head -1)" )
    PACKFAIL=0
    for P in BP RP; do
      diff -rq "/tmp/hamn-packcmp/a/PurrfectCompanions_$P" \
               "$(ls -d /tmp/hamn-packcmp/v/*/PurrfectCompanions_$P | head -1)" >/dev/null 2>&1 || PACKFAIL=1
    done
    [ "$PACKFAIL" -eq 0 ] \
      && ok "addonets paket är bitidentiska med världens inbäddade (samma UUID+version kräver samma innehåll)" \
      || bad "addon v$AV och världens inbäddade paket SKILJER SIG — samma UUID+version med olika innehåll vägrar ladda på Xbox"
  fi
fi

echo
if [ "$FAIL" -eq 0 ]; then echo "=== STJÄRNHAMNEN GRÖNT ==="; exit 0; fi
echo "=== FEL HITTADE ==="; exit 1
