    _lang=open(f"{SRC}/PurrfectCompanions_BP/texts/en_US.lang",encoding="utf-8").read()
    # Vi definierar ALLA nycklar vi refererar, även sådana vanilla råkar ha —
    # vår egen rad vinner ändå, och då kan regeln vara enkel och strikt.
    for grp in groups.values():
        for inter in grp.get("minecraft:interact",{}).get("interactions",[]):
            t=inter.get("interact_text","")
            if t and t not in _lang:
