    # namnnycklar i BÅDA formerna (med/utan namespace) i varje språkfil —
    # varianten döper om katterna, så källans gröna check räcker inte här
    cid = e["identifier"]; short = cid.split(":", 1)[1]
    for lf in glob.glob(f"{rp}/texts/*.lang"):
        lt = open(lf, encoding="utf-8").read()
        keys = [f"entity.{cid}.name=", f"entity.{short}.name="]
        if "spawn_egg" in e: keys.append(f"item.spawn_egg.entity.{cid}.name=")
        for k in keys:
            if k not in lt: bad.append(f"{cid}: {k[:-1]} saknas i {os.path.basename(lf)}")
print("\n".join(bad))
PYV
)
  if [ -n "$OUT" ]; then echo "$OUT" | while read -r l; do bad "variant $V: $l"; done; FAIL=1
  else ok "variant $V: alla textur- och ikonreferenser stämmer"; fi
  python3 -c "
import json
for p in ('PurrfectCompanions_BP','PurrfectCompanions_RP'):
